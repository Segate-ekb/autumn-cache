// Порядок вытеснения записей кэша: сегментированный LRU с весами.
// Новая запись попадает в испытательный сегмент, повторное обращение переводит её в защищённый.

Перем Испытательный;
Перем Защищённый;
Перем ВесВсего;
Перем ВесЗащищённого;
Перем ПределЗащищённого;

// Ставит новую запись в голову испытательного сегмента.
//
// Параметры:
//   Запись - Структура - Запись кэша с полями Вес, Защищена, Пред, След
//
Процедура Добавить(Запись) Экспорт

	Запись.Защищена = Ложь;
	Вставить(Испытательный, Запись);
	ВесВсего = ВесВсего + Запись.Вес;

КонецПроцедуры

// Переносит запись в голову защищённого сегмента; при его переполнении хвост защищённого
// возвращается в испытательный.
//
// Параметры:
//   Запись - Структура - Запись, уже стоящая в очереди
//
Процедура Обратиться(Запись) Экспорт

	Вырезать(Запись);
	Если НЕ Запись.Защищена Тогда
		Запись.Защищена = Истина;
		ВесЗащищённого = ВесЗащищённого + Запись.Вес;
	КонецЕсли;
	Вставить(Защищённый, Запись);

	Пока ВесЗащищённого > ПределЗащищённого Цикл
		Хвост = Защищённый.Пред;
		Вырезать(Хвост);
		Хвост.Защищена = Ложь;
		ВесЗащищённого = ВесЗащищённого - Хвост.Вес;
		Вставить(Испытательный, Хвост);
	КонецЦикла;

КонецПроцедуры

// Убирает запись из очереди.
//
// Параметры:
//   Запись - Структура - Запись, стоящая в очереди
//
Процедура Убрать(Запись) Экспорт

	Вырезать(Запись);
	ВесВсего = ВесВсего - Запись.Вес;
	Если Запись.Защищена Тогда
		ВесЗащищённого = ВесЗащищённого - Запись.Вес;
	КонецЕсли;

КонецПроцедуры

// Следующая запись на вытеснение: хвост испытательного сегмента, а если он пуст — хвост защищённого.
//
// Возвращаемое значение:
//   Структура, Неопределено - Запись или Неопределено, если очередь пуста
//
Функция Жертва() Экспорт

	Если Испытательный.Пред <> Испытательный Тогда
		Возврат Испытательный.Пред;
	ИначеЕсли Защищённый.Пред <> Защищённый Тогда
		Возврат Защищённый.Пред;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Суммарный вес записей в очереди.
//
// Возвращаемое значение:
//   Число - Вес
//
Функция Вес() Экспорт
	Возврат ВесВсего;
КонецФункции

// Сегмент — кольцо с головой-заглушкой: Голова.След — самая свежая запись, Голова.Пред — хвост.
Функция НовыйСегмент()

	Голова = Новый Структура("Пред, След");
	Голова.Пред = Голова;
	Голова.След = Голова;

	Возврат Голова;

КонецФункции

Процедура Вставить(Голова, Запись)

	Запись.Пред = Голова;
	Запись.След = Голова.След;
	Голова.След.Пред = Запись;
	Голова.След = Запись;

КонецПроцедуры

Процедура Вырезать(Запись)

	Запись.Пред.След = Запись.След;
	Запись.След.Пред = Запись.Пред;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Предел)

	Испытательный = НовыйСегмент();
	Защищённый = НовыйСегмент();
	ВесВсего = 0;
	ВесЗащищённого = 0;
	ПределЗащищённого = Предел * 0.8;

КонецПроцедуры
