// Поставщик кэша в памяти: запись хранит значение, а поток и отданный файл — их ДвоичныеДанные.
// Вес записи — 1 или, при пределе в байтах, оценка памяти под запись; тогда значения только неизменяемые.

Перем ВБайтах;

// Вес записи в пределе кэша.
//
// Параметры:
//   Значение    - Произвольный - Значение записи; при пределе в байтах — примитив, ДвоичныеДанные
//                 или фиксированная коллекция из них, иначе вызывается исключение
//   ТекстКлюча  - Строка - Текст ключа записи
//
// Возвращаемое значение:
//   Число - 1 или оценка в байтах: запись, ключ и значение
//
Функция Вес(Значение, ТекстКлюча) Экспорт

	Если НЕ ВБайтах Тогда
		Возврат 1;
	КонецЕсли;

	Возврат НакладныеЗаписи(ТекстКлюча) + ВесВБайтах(Значение);

КонецФункции

// Вес потоковой записи — из потока или готового файла: как у ДвоичныхДанных того же размера.
//
// Параметры:
//   Размер     - Число, Неопределено - Байт в записи; Неопределено, если поток не знает своего размера
//   ТекстКлюча - Строка - Текст ключа записи
//
// Возвращаемое значение:
//   Число - 1 или оценка в байтах: запись, ключ и данные
//
Функция ВесПотока(Размер, ТекстКлюча) Экспорт

	Если НЕ ВБайтах Тогда
		Возврат 1;
	КонецЕсли;

	Если Размер = Неопределено Тогда
		ВызватьИсключение
			"кэш в памяти с пределом в байтах хранит только потоки с изменением позиции: вес записи нужен до чтения";
	КонецЕсли;

	Возврат НакладныеЗаписи(ТекстКлюча) + ВесДвоичныхДанных(Размер);

КонецФункции

// Сохраняет значение.
//
// Параметры:
//   Значение - Произвольный - Значение записи
//
// Возвращаемое значение:
//   Произвольный - Данные записи: само значение
//
Функция Записать(Значение) Экспорт
	Возврат Значение;
КонецФункции

// Вычитывает поток от текущей позиции в ДвоичныеДанные: поток читается один раз,
// а запись отдаётся многократно.
//
// Параметры:
//   Поток - Поток, ФайловыйПоток, ПотокВПамяти - Поток
//
// Возвращаемое значение:
//   ДвоичныеДанные - Данные записи
//
Функция ЗаписатьПоток(Поток) Экспорт

	Копия = Новый ПотокВПамяти();
	Поток.КопироватьВ(Копия);

	Возврат Копия.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// Вычитывает готовый файл в ДвоичныеДанные и удаляет его: файл отдан кэшу.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
// Возвращаемое значение:
//   ДвоичныеДанные - Данные записи
//
Функция ЗабратьФайл(Путь) Экспорт

	Данные = Новый ДвоичныеДанные(Путь);
	УдалитьФайлы(Путь);

	Возврат Данные;

КонецФункции

// Читает значение по данным записи.
//
// Параметры:
//   Данные - Произвольный - Данные записи
//
// Возвращаемое значение:
//   Произвольный - Значение
//
Функция Прочитать(Данные) Экспорт
	Возврат Данные;
КонецФункции

// Открывает поток на чтение над данными потоковой записи, без копии.
//
// Параметры:
//   Данные - ДвоичныеДанные - Данные записи
//
// Возвращаемое значение:
//   Поток - Поток только для чтения
//
Функция ОткрытьПоток(Данные) Экспорт
	Возврат Данные.ОткрытьПотокДляЧтения();
КонецФункции

// Освобождает данные вытесненной записи.
//
// Параметры:
//   Данные - Произвольный - Данные записи
//
Процедура Удалить(Данные) Экспорт
КонецПроцедуры

// Структура записи, элемент индекса и узел очереди — замер 200 тыс. записей на OneScript 2.2 — и ключ.
Функция НакладныеЗаписи(ТекстКлюча)
	Возврат 1750 + ВесВБайтах(ТекстКлюча);
КонецФункции

// Коэффициенты сняты замером памяти процесса OneScript 2.2 на значениях каждого вида.
Функция ВесВБайтах(Значение)

	Тип = ТипЗнч(Значение);

	Если Тип = Тип("Булево") ИЛИ Тип = Тип("Неопределено") ИЛИ Тип = Тип("Null") Тогда
		Возврат 0;
	ИначеЕсли Тип = Тип("Число") Тогда
		Возврат 32;
	ИначеЕсли Тип = Тип("Дата") ИЛИ Тип = Тип("УникальныйИдентификатор") Тогда
		Возврат 40;
	ИначеЕсли Тип = Тип("Строка") Тогда
		Возврат 56 + 2 * СтрДлина(Значение);
	ИначеЕсли Тип = Тип("ДвоичныеДанные") Тогда
		Возврат ВесДвоичныхДанных(Значение.Размер());
	ИначеЕсли Тип = Тип("ФиксированнаяСтруктура") Тогда
		Вес = 700;
		Для Каждого КлючИЗначение Из Значение Цикл
			Вес = Вес + 100 + ВесВБайтах(КлючИЗначение.Ключ) + ВесВБайтах(КлючИЗначение.Значение);
		КонецЦикла;
		Возврат Вес;
	ИначеЕсли Тип = Тип("ФиксированноеСоответствие") Тогда
		Вес = 200;
		Для Каждого КлючИЗначение Из Значение Цикл
			Вес = Вес + 52 + ВесВБайтах(КлючИЗначение.Ключ) + ВесВБайтах(КлючИЗначение.Значение);
		КонецЦикла;
		Возврат Вес;
	ИначеЕсли Тип = Тип("ФиксированныйМассив") Тогда
		Вес = 180;
		Для Каждого Элемент Из Значение Цикл
			Вес = Вес + 8 + ВесВБайтах(Элемент);
		КонецЦикла;
		Возврат Вес;
	ИначеЕсли Тип = Тип("Структура") ИЛИ Тип = Тип("Соответствие") ИЛИ Тип = Тип("Массив")
		ИЛИ Тип = Тип("ТаблицаЗначений") ИЛИ Тип = Тип("СписокЗначений") ИЛИ Тип = Тип("ДеревоЗначений") Тогда
		ВызватьИсключение СтрШаблон(
			"значение типа %1 изменяемое, кэш в памяти с пределом в байтах хранит фиксированные коллекции", Тип);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("вес значения типа %1 не оценивается, кэш в памяти с пределом в байтах его не хранит", Тип);

КонецФункции

Функция ВесДвоичныхДанных(Размер)
	Возврат 100 + Размер;
КонецФункции

Процедура ПриСозданииОбъекта(ПределВБайтах = Ложь)
	ВБайтах = ПределВБайтах;
КонецПроцедуры
