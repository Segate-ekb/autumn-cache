// Поставщик кэша в памяти: запись хранит само значение, вес каждой записи — 1.

// Вес значения в пределе кэша.
//
// Параметры:
//   Значение - Произвольный - Значение записи
//
// Возвращаемое значение:
//   Число - Всегда 1
//
Функция Вес(Значение) Экспорт
	Возврат 1;
КонецФункции

// Сохраняет значение.
//
// Параметры:
//   Значение - Произвольный - Значение записи
//
// Возвращаемое значение:
//   Произвольный - Данные записи: само значение
//
Функция Записать(Значение) Экспорт
	Возврат Значение;
КонецФункции

// Читает значение по данным записи.
//
// Параметры:
//   Данные - Произвольный - Данные записи
//
// Возвращаемое значение:
//   Произвольный - Значение
//
Функция Прочитать(Данные) Экспорт
	Возврат Данные;
КонецФункции

// Освобождает данные вытесненной записи.
//
// Параметры:
//   Данные - Произвольный - Данные записи
//
Процедура Удалить(Данные) Экспорт
КонецПроцедуры
