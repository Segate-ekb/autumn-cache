#Использовать annotations
#Использовать decorator
#Использовать reflector

// Напильник &Кэшируемый и &СбрасываетКэш: оборачивает методы желудя перехватчиками кэша.
// Ключ строится в перехватчике Вместо, внутри попытки вызова; перехватчик После не вызывает исключений.

Перем ТабакеркаМенеджера;
Перем Менеджер;

// Оборачивает желудь с методами &Кэшируемый и &СбрасываетКэш в декоратор с перехватчиками кэша.
//
// Параметры:
//   Желудь            - Произвольный      - Экземпляр желудя
//   ОпределениеЖелудя - ОпределениеЖелудя - Метаданные желудя
//
// Возвращаемое значение:
//   Произвольный - Исходный желудь или декоратор над ним
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Методы = МетодыСАннотациямиКэша(ОпределениеЖелудя);
	Если Методы.Количество() = 0 Тогда
		Возврат Желудь;
	КонецЕсли;

	Перехватчики = Новый Массив;
	Для Каждого Метод Из Методы Цикл
		Для Каждого Перехватчик Из ПерехватчикиМетода(Метод, ОпределениеЖелудя.Имя()) Цикл
			Перехватчики.Добавить(Перехватчик);
		КонецЦикла;
	КонецЦикла;

	Кэши = СоздатьКэшиМетодов(Методы);

	Построитель = Новый ПостроительДекоратора(Желудь).Поле(Новый Поле("Декоратор_Кэши"));
	Для Каждого Перехватчик Из Перехватчики Цикл
		Построитель.Перехватчик(Перехватчик);
	КонецЦикла;

	Декоратор = Построитель.Построить();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Декоратор, "Декоратор_Кэши", Кэши);

	Возврат Декоратор;

КонецФункции

// Аннотация кэша на неэкспортном методе — ошибка: декоратор перехватывает только экспортные методы.
Функция МетодыСАннотациямиКэша(ОпределениеЖелудя)

	// Примитивному желудю рефлектор отказывает, а методов у него нет.
	Если ОпределениеЖелудя.Методы().Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Методы = Новый Соответствие;
	Для Каждого ИмяАннотации Из СтрРазделить("Кэшируемый,СбрасываетКэш", ",") Цикл

		Для Каждого Метод Из ОпределениеЖелудя.РефлекторОбъекта().ПолучитьТаблицуМетодов(ИмяАннотации, Ложь) Цикл
			Если НЕ Метод.Экспорт Тогда
				ВызватьИсключение СтрШаблон("&%1 на %2.%3: метод должен быть экспортным",
					ИмяАннотации, ОпределениеЖелудя.Имя(), Метод.Имя);
			КонецЕсли;
		КонецЦикла;

		Для Каждого Метод Из ОпределениеЖелудя.НайтиМетодыСАннотациями(ИмяАннотации) Цикл
			Методы.Вставить(Метод.Имя, Метод);
		КонецЦикла;

	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого ИмяИМетод Из Методы Цикл
		Результат.Добавить(ИмяИМетод.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кэши создаются при сборке желудя, чтобы ошибки настроек проявились сразу.
Функция СоздатьКэшиМетодов(Методы)

	Если Менеджер = Неопределено Тогда
		Менеджер = ТабакеркаМенеджера.Достать();
	КонецЕсли;

	Кэши = Новый Соответствие;
	Для Каждого Метод Из Методы Цикл
		Для Каждого Аннотация Из АннотацииКэша(Метод) Цикл
			Имя = ИмяКэша(Аннотация);
			Кэши.Вставить(Имя, Менеджер.Кэш(Имя));
		КонецЦикла;
	КонецЦикла;

	Возврат Кэши;

КонецФункции

Функция ПерехватчикиМетода(Метод, ИмяЖелудя)

	Кэшируемый = РаботаСАннотациями.ПолучитьАннотацию(Метод, "Кэшируемый");
	Если Кэшируемый <> Неопределено И НЕ Метод.ЭтоФункция Тогда
		ВызватьИсключение СтрШаблон(
			"&Кэшируемый на %1.%2: кэшировать можно только функцию", ИмяЖелудя, Метод.Имя);
	КонецЕсли;

	НуженКлюч = Кэшируемый <> Неопределено;
	ТелоВместо = "";
	ТелоПосле = "";

	Если Кэшируемый <> Неопределено Тогда
		Обращение = ОбращениеККэшу(Кэшируемый);
		ТелоВместо = "Декоратор_ПоколениеКэша = " + Обращение + ".Поколение();
			|Декоратор_ИзКэша = " + Обращение + ".Получить(Декоратор_КлючКэша);
			|Если Декоратор_ИзКэша <> Неопределено Тогда
			|	Декоратор_ВозвращаемоеИзМетодаЗначение = Декоратор_ИзКэша;
			|КонецЕсли;";
		ТелоПосле = "Если Декоратор_ИзКэша = Неопределено Тогда
			|	" + Обращение + ".Запомнить(Декоратор_КлючКэша, Декоратор_ВозвращаемоеИзМетодаЗначение, Декоратор_ПоколениеКэша);
			|КонецЕсли;";
	КонецЕсли;

	Для Каждого Сброс Из РаботаСАннотациями.ПолучитьАннотации(Метод, "СбрасываетКэш") Цикл
		Если РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Сброс, "ВсеЗаписи", Ложь) = Истина Тогда
			ТелоПосле = ТелоПосле + Символы.ПС + ОбращениеККэшу(Сброс) + ".Очистить();";
		Иначе
			НуженКлюч = Истина;
			ТелоПосле = ТелоПосле + Символы.ПС + ОбращениеККэшу(Сброс) + ".Удалить(Декоратор_КлючКэша);";
		КонецЕсли;
	КонецЦикла;

	Если НуженКлюч Тогда
		ТелоВместо = КодСборкиКлюча(Метод) + Символы.ПС + ТелоВместо;
	КонецЕсли;

	Перехватчики = Новый Массив;
	Если НЕ ПустаяСтрока(ТелоВместо) Тогда
		Перехватчики.Добавить(Новый Перехватчик(Метод.Имя)
			.ТипПерехватчика(ТипыПерехватчиковМетода.Вместо)
			.Тело(ТелоВместо));
	КонецЕсли;
	Перехватчики.Добавить(Новый Перехватчик(Метод.Имя)
		.ТипПерехватчика(ТипыПерехватчиковМетода.После)
		.Тело(ТелоПосле));

	Возврат Перехватчики;

КонецФункции

// Ключ собирается из параметров с &КлючКэша, а если таких нет — из всех параметров метода.
Функция КодСборкиКлюча(Метод)

	Все = Новый Массив;
	Помеченные = Новый Массив;

	Для Каждого Параметр Из Метод.Параметры Цикл
		Добавление = ".Добавить(" + Параметр.Имя + ")";
		Все.Добавить(Добавление);
		Если Параметр.Аннотации <> Неопределено
			И РаботаСАннотациями.НайтиАннотацию(Параметр.Аннотации, "КлючКэша") <> Неопределено Тогда
			Помеченные.Добавить(Добавление);
		КонецЕсли;
	КонецЦикла;

	Части = ?(Помеченные.Количество() > 0, Помеченные, Все);

	Возврат "Декоратор_КлючКэша = Новый КлючКэша()" + СтрСоединить(Части) + ";";

КонецФункции

Функция АннотацииКэша(Метод)

	Результат = РаботаСАннотациями.ПолучитьАннотации(Метод, "СбрасываетКэш");
	Кэшируемый = РаботаСАннотациями.ПолучитьАннотацию(Метод, "Кэшируемый");
	Если Кэшируемый <> Неопределено Тогда
		Результат.Добавить(Кэшируемый);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ИмяКэша(Аннотация)
	Возврат РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Значение", "");
КонецФункции

// Обращение к кэшу из поля декоратора в тексте перехватчика.
Функция ОбращениеККэшу(Аннотация)
	Возврат "Декоратор_Кэши[""" + СтрЗаменить(ИмяКэша(Аннотация), """", """""") + """]";
КонецФункции

&Напильник
&Порядок(400)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("МенеджерКэшей") ТабакеркаМенеджераКэшей)
	ТабакеркаМенеджера = ТабакеркаМенеджераКэшей;
КонецПроцедуры
