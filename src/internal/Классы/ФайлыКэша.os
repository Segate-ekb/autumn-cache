#Использовать logos

// Поставщик кэша в файлах каталога: запись хранит путь к файлу, вес записи — размер в байтах.
// Неудалённые файлы ждут повторной уборки; файлы *.cache прошлого запуска убираются при создании.

Перем Каталог;
Перем Неубранные;
Перем ЗамокУборки;
Перем Лог;

// Вес записи в пределе кэша: место на диске, ключ не учитывается.
//
// Параметры:
//   Значение   - ДвоичныеДанные - Значение записи; другие типы файловый кэш не хранит
//   ТекстКлюча - Строка - Текст ключа записи
//
// Возвращаемое значение:
//   Число - Размер в байтах
//
Функция Вес(Значение, ТекстКлюча) Экспорт

	Если ТипЗнч(Значение) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение СтрШаблон(
			"файловый кэш хранит только ДвоичныеДанные, получено значение типа %1", ТипЗнч(Значение));
	КонецЕсли;

	Возврат Значение.Размер();

КонецФункции

// Вес потоковой записи — из потока или готового файла: место на диске.
//
// Параметры:
//   Размер     - Число, Неопределено - Байт в записи; Неопределено, если поток не знает своего размера
//   ТекстКлюча - Строка - Текст ключа записи
//
// Возвращаемое значение:
//   Число - Размер в байтах
//
Функция ВесПотока(Размер, ТекстКлюча) Экспорт

	Если Размер = Неопределено Тогда
		ВызватьИсключение "файловый кэш хранит только потоки с изменением позиции: размер записи нужен до копирования";
	КонецЕсли;

	Возврат Размер;

КонецФункции

// Записывает значение в новый файл каталога.
//
// Параметры:
//   Значение - ДвоичныеДанные - Значение записи
//
// Возвращаемое значение:
//   Строка - Путь к файлу
//
Функция Записать(Значение) Экспорт

	Путь = НовыйПуть();
	Попытка
		Значение.Записать(Путь);
	Исключение
		Удалить(Путь);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Путь;

КонецФункции

// Копирует поток от текущей позиции в новый файл каталога порциями, не поднимая его в память.
//
// Параметры:
//   Поток - Поток, ФайловыйПоток, ПотокВПамяти - Поток с изменением позиции
//
// Возвращаемое значение:
//   Строка - Путь к файлу
//
Функция ЗаписатьПоток(Поток) Экспорт

	Путь = НовыйПуть();
	Файл = Неопределено;
	Попытка
		Файл = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
		Поток.КопироватьВ(Файл);
		Файл.Закрыть();
	Исключение
		Если Файл <> Неопределено Тогда
			Файл.Закрыть();
		КонецЕсли;
		Удалить(Путь);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Путь;

КонецФункции

// Забирает готовый файл в каталог перемещением, не переписывая содержимое: на macOS и Linux читатели,
// открывшие файл раньше, дочитывают его. Между томами перемещение копирует файл и удаляет источник.
// При сбое файл остаётся на месте.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
// Возвращаемое значение:
//   Строка - Путь к файлу записи
//
Функция ЗабратьФайл(Путь) Экспорт

	ПутьЗаписи = НовыйПуть();
	Попытка
		ПереместитьФайл(Путь, ПутьЗаписи);
	Исключение
		Удалить(ПутьЗаписи);
		ВызватьИсключение;
	КонецПопытки;

	Возврат ПутьЗаписи;

КонецФункции

// Читает значение из файла.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
// Возвращаемое значение:
//   ДвоичныеДанные, Неопределено - Значение или Неопределено, если файла уже нет
//
Функция Прочитать(Путь) Экспорт

	// Файл могли вытеснить между поиском записи и чтением.
	Попытка
		Возврат Новый ДвоичныеДанные(Путь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Открывает файл записи на чтение. Читатели одного файла друг другу не мешают; на macOS и Linux
// открытый поток дочитывается до конца и после удаления файла.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
// Возвращаемое значение:
//   ФайловыйПоток, Неопределено - Поток или Неопределено, если файла уже нет
//
Функция ОткрытьПоток(Путь) Экспорт

	// Файл могли вытеснить между поиском записи и открытием.
	Попытка
		Возврат ФайловыеПотоки.ОткрытьДляЧтения(Путь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Удаляет файл убранной записи и повторяет уборку файлов, которые не удалились раньше.
// Файл, который не удалился и сейчас, остаётся в уборке; сбой пишется в журнал.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
Процедура Удалить(Путь) Экспорт

	ЗамокУборки.Заблокировать();
	Попытка
		ПовторитьУборку();
		Причина = ПричинаНеудаления(Путь);
		Если ЗначениеЗаполнено(Причина) Тогда
			Неубранные.Добавить(Путь);
			Лог.Предупреждение("Не удалось удалить файл кэша %1, повтор при следующей уборке: %2", Путь, Причина);
		КонецЕсли;
	Исключение
		ЗамокУборки.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	ЗамокУборки.Разблокировать();

КонецПроцедуры

Процедура ПовторитьУборку()

	Оставшиеся = Новый Массив;
	Для Каждого Путь Из Неубранные Цикл
		Если ЗначениеЗаполнено(ПричинаНеудаления(Путь)) Тогда
			Оставшиеся.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;
	Неубранные = Оставшиеся;

КонецПроцедуры

// Удаляет файл; пустая строка, если файла больше нет, иначе — почему он остался.
Функция ПричинаНеудаления(Путь)

	Попытка
		УдалитьФайлы(Путь);
	Исключение
		Если Новый Файл(Путь).Существует() Тогда
			Возврат ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

	Возврат "";

КонецФункции

Функция НовыйПуть()
	Возврат ОбъединитьПути(Каталог, Строка(Новый УникальныйИдентификатор) + ".cache");
КонецФункции

Процедура ПриСозданииОбъекта(КаталогКэша)

	Каталог = Новый Файл(КаталогКэша).ПолноеИмя;
	СоздатьКаталог(Каталог);
	Неубранные = Новый Массив;
	ЗамокУборки = Новый БлокировкаРесурса(ЭтотОбъект);
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

	Для Каждого Файл Из НайтиФайлы(Каталог, "*.cache") Цикл
		Удалить(Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры
