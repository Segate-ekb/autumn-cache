#Использовать logos

// Поставщик кэша в файлах каталога: запись хранит путь к файлу, вес записи — размер в байтах.
// При создании из каталога удаляются файлы *.cache, оставшиеся от прошлого запуска.

Перем Каталог;
Перем Лог;

// Вес значения в пределе кэша.
//
// Параметры:
//   Значение - ДвоичныеДанные - Значение записи; другие типы файловый кэш не хранит
//
// Возвращаемое значение:
//   Число - Размер в байтах
//
Функция Вес(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение СтрШаблон(
			"файловый кэш хранит только ДвоичныеДанные, получено значение типа %1", ТипЗнч(Значение));
	КонецЕсли;

	Возврат Значение.Размер();

КонецФункции

// Записывает значение в новый файл каталога.
//
// Параметры:
//   Значение - ДвоичныеДанные - Значение записи
//
// Возвращаемое значение:
//   Строка - Путь к файлу
//
Функция Записать(Значение) Экспорт

	Путь = ОбъединитьПути(Каталог, Строка(Новый УникальныйИдентификатор) + ".cache");
	Попытка
		Значение.Записать(Путь);
	Исключение
		Удалить(Путь);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Путь;

КонецФункции

// Читает значение из файла.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
// Возвращаемое значение:
//   ДвоичныеДанные, Неопределено - Значение или Неопределено, если файла уже нет
//
Функция Прочитать(Путь) Экспорт

	// Файл могли вытеснить между поиском записи и чтением.
	Попытка
		Возврат Новый ДвоичныеДанные(Путь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Удаляет файл вытесненной записи; сбой удаления пишется в журнал.
//
// Параметры:
//   Путь - Строка - Путь к файлу
//
Процедура Удалить(Путь) Экспорт

	Попытка
		УдалитьФайлы(Путь);
	Исключение
		Лог.Предупреждение("Не удалось удалить файл кэша %1: %2", Путь, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(КаталогКэша)

	Каталог = Новый Файл(КаталогКэша).ПолноеИмя;
	СоздатьКаталог(Каталог);
	УдалитьФайлы(Каталог, "*.cache");
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
