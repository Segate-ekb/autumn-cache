// Ключ записи кэша: значения примитивных типов, собранные в однозначный текст.

Перем Части;

// Добавляет значение в конец ключа.
//
// Параметры:
//   Значение - Строка, Число, Дата, Булево, УникальныйИдентификатор, Неопределено - Часть ключа
//
// Возвращаемое значение:
//   КлючКэша - Этот ключ
//
Функция Добавить(Значение) Экспорт

	Тип = ТипЗнч(Значение);

	Если Тип = Тип("Строка") Тогда
		Метка = "С";
	ИначеЕсли Тип = Тип("Число") Тогда
		Метка = "Ч";
	ИначеЕсли Тип = Тип("Дата") Тогда
		Метка = "Д";
	ИначеЕсли Тип = Тип("Булево") Тогда
		Метка = "Б";
	ИначеЕсли Тип = Тип("УникальныйИдентификатор") Тогда
		Метка = "У";
	ИначеЕсли Тип = Тип("Неопределено") Тогда
		Метка = "Н";
	Иначе
		ВызватьИсключение СтрШаблон(
			"Значение типа %1 не может быть частью ключа кэша (часть №%2)", Тип, Части.Количество() + 1);
	КонецЕсли;

	Текст = ?(Метка = "Ч", ЧислоБезХвостовыхНулей(Значение), XMLСтрока(Значение));
	Части.Добавить(Метка + СтрДлина(Текст) + ":" + Текст);

	Возврат ЭтотОбъект;

КонецФункции

// Текст ключа, по которому кэш хранит запись.
//
// Возвращаемое значение:
//   Строка - Текст ключа
//
Функция Текст() Экспорт
	Возврат СтрСоединить(Части);
КонецФункции

// XMLСтрока сохраняет масштаб десятичного числа: 1.0 и 1 дали бы разные ключи.
Функция ЧислоБезХвостовыхНулей(Число)

	Текст = XMLСтрока(Число);
	Если СтрНайти(Текст, ".") = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(Текст, "0") Цикл
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЦикла;

	Если СтрЗаканчиваетсяНа(Текст, ".") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;

	Возврат Текст;

КонецФункции

Процедура ПриСозданииОбъекта()
	Части = Новый Массив;
КонецПроцедуры
