#Использовать "../internal"
#Использовать logos

// Кэши приложения по именам. Настройки кэша читаются из деталек cache.<имя>.Поставщик,
// Предел, СрокЖизни и Каталог; без настроек кэш живёт в памяти с пределом 1000 записей.

Перем Поделка;
Перем Кэши;
Перем Замок;
Перем Лог;

// Возвращает кэш по имени; при первом обращении создаёт его по настройкам.
//
// Параметры:
//   Имя - Строка - Имя кэша, непустое и без точек; регистр не различается
//
// Возвращаемое значение:
//   Кэш - Кэш с этим именем
//
Функция Кэш(Имя) Экспорт

	КлючИмени = НРег(Имя);

	Замок.Заблокировать();
	Попытка
		Результат = Кэши[КлючИмени];
		Если Результат = Неопределено Тогда
			Результат = НовыйКэш(Имя);
			Кэши.Вставить(КлючИмени, Результат);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Результат;

КонецФункции

Функция НовыйКэш(Имя)

	Если ПустаяСтрока(Имя) ИЛИ СтрНайти(Имя, ".") > 0 Тогда
		ВызватьИсключение СтрШаблон("Имя кэша ""%1"" должно быть непустым и без точек", Имя);
	КонецЕсли;

	Префикс = "cache." + Имя + ".";
	ВидПоставщика = НРег(Поделка.НайтиДетальку(Префикс + "Поставщик", "память"));
	СрокЖизни = Число(Поделка.НайтиДетальку(Префикс + "СрокЖизни", 0));

	Если ВидПоставщика = "память" Тогда
		Предел = Число(Поделка.НайтиДетальку(Префикс + "Предел", 1000));
		Поставщик = Новый ПамятьКэша();
		НаибольшийВес = Предел;
	ИначеЕсли ВидПоставщика = "файлы" Тогда
		ДоляЗаписи = 0.1;
		Предел = Число(ОбязательнаяНастройка(Префикс + "Предел"));
		Поставщик = Новый ФайлыКэша(ОбязательнаяНастройка(Префикс + "Каталог"));
		НаибольшийВес = Предел * ДоляЗаписи;
	Иначе
		ВызватьИсключение СтрШаблон(
			"Неизвестный поставщик кэша ""%1"" в %2Поставщик: ожидается ""память"" или ""файлы""",
			ВидПоставщика, Префикс);
	КонецЕсли;

	Если Предел <= 0 ИЛИ СрокЖизни < 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Кэш ""%1"": Предел должен быть больше нуля, СрокЖизни — не меньше нуля", Имя);
	КонецЕсли;

	Лог.Информация("Кэш ""%1"": поставщик %2, предел %3, срок жизни %4 с", Имя, ВидПоставщика, Предел, СрокЖизни);

	Возврат Новый Кэш(Имя, Поставщик, Предел, НаибольшийВес, СрокЖизни);

КонецФункции

Функция ОбязательнаяНастройка(Ключ)

	Значение = Поделка.НайтиДетальку(Ключ);
	Если Значение = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Для файлового кэша обязательна настройка %1", Ключ);
	КонецЕсли;

	Возврат Значение;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") Контекст)

	Поделка = Контекст;
	Кэши = Новый Соответствие;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
