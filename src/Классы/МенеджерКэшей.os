#Использовать "../internal"
#Использовать logos

// Кэши приложения по именам. Настройки кэша читаются из деталек cache.<имя>.Поставщик,
// Предел, СрокЖизни и Каталог. Кэш в памяти без своего предела делит общий бюджет в байтах
// cache.ПределПамяти, а без него живёт с пределом 1000 записей.

Перем Поделка;
Перем Кэши;
Перем ОбщийБюджет;
Перем Замок;
Перем Лог;

// Возвращает кэш по имени; при первом обращении создаёт его по настройкам.
//
// Параметры:
//   Имя - Строка - Имя кэша, непустое и без точек; регистр не различается
//
// Возвращаемое значение:
//   Кэш - Кэш с этим именем
//
Функция Кэш(Имя) Экспорт

	КлючИмени = НРег(Имя);

	Замок.Заблокировать();
	Попытка
		Результат = Кэши[КлючИмени];
		Если Результат = Неопределено Тогда
			Результат = НовыйКэш(Имя);
			Кэши.Вставить(КлючИмени, Результат);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Результат;

КонецФункции

Функция НовыйКэш(Имя)

	Если ПустаяСтрока(Имя) ИЛИ СтрНайти(Имя, ".") > 0 ИЛИ НРег(Имя) = "пределпамяти" Тогда
		ВызватьИсключение СтрШаблон("Имя кэша ""%1"" должно быть непустым, без точек и не ПределПамяти", Имя);
	КонецЕсли;

	Префикс = "cache." + Имя + ".";
	ВидПоставщика = НРег(Поделка.НайтиДетальку(Префикс + "Поставщик", "память"));
	Если ВидПоставщика <> "память" И ВидПоставщика <> "файлы" Тогда
		ВызватьИсключение СтрШаблон(
			"Неизвестный поставщик кэша ""%1"" в %2Поставщик: ожидается ""память"" или ""файлы""",
			ВидПоставщика, Префикс);
	КонецЕсли;
	ВФайлах = ВидПоставщика = "файлы";
	ВОбщемБюджете = НЕ ВФайлах
		И Поделка.НайтиДетальку(Префикс + "Предел") = Неопределено
		И Поделка.НайтиДетальку("cache.ПределПамяти") <> Неопределено;

	Если ВОбщемБюджете Тогда
		Бюджет = БюджетКэшейВПамяти();
	Иначе
		Предел = ЧисловаяНастройка(Префикс + "Предел", ?(ВФайлах, Неопределено, 1000));
		ПроверитьПредел(Предел, Префикс + "Предел");
		Бюджет = Новый БюджетКэша(Предел, ?(ВФайлах, Предел * ДоляЗаписи(), Предел));
	КонецЕсли;

	СрокЖизни = ЧисловаяНастройка(Префикс + "СрокЖизни", 0);
	Если СрокЖизни < 0 Тогда
		ВызватьИсключение СтрШаблон("Настройка %1СрокЖизни не может быть меньше нуля", Префикс);
	КонецЕсли;

	Если ВФайлах Тогда
		Поставщик = Новый ФайлыКэша(ОбязательнаяНастройка(Префикс + "Каталог"));
	Иначе
		Поставщик = Новый ПамятьКэша(ВОбщемБюджете);
	КонецЕсли;

	Лог.Информация("Кэш ""%1"": поставщик %2, предел %3%4, срок жизни %5 с", Имя, ВидПоставщика, Бюджет.Предел,
		?(ВОбщемБюджете, " байт общего бюджета", ?(ВФайлах, " байт", " записей")), СрокЖизни);

	Возврат Новый Кэш(Имя, Поставщик, Бюджет, СрокЖизни);

КонецФункции

// Общий бюджет кэшей в памяти создаётся при первом кэше, который в него входит.
Функция БюджетКэшейВПамяти()

	Если ОбщийБюджет = Неопределено Тогда
		Предел = ЧисловаяНастройка("cache.ПределПамяти", Неопределено);
		ПроверитьПредел(Предел, "cache.ПределПамяти");
		ОбщийБюджет = Новый БюджетКэша(Предел, Предел * ДоляЗаписи());
	КонецЕсли;

	Возврат ОбщийБюджет;

КонецФункции

Процедура ПроверитьПредел(Предел, Ключ)

	Если Предел <= 0 Тогда
		ВызватьИсключение СтрШаблон("Настройка %1 должна быть больше нуля", Ключ);
	КонецЕсли;

КонецПроцедуры

// Наибольшая запись — доля предела: одна запись не вытесняет весь кэш.
Функция ДоляЗаписи()
	Возврат 0.1;
КонецФункции

// Без значения по умолчанию настройка обязательна.
Функция ЧисловаяНастройка(Ключ, ЗначениеПоУмолчанию)

	Если ЗначениеПоУмолчанию = Неопределено Тогда
		Значение = ОбязательнаяНастройка(Ключ);
	Иначе
		Значение = Поделка.НайтиДетальку(Ключ, ЗначениеПоУмолчанию);
	КонецЕсли;

	Попытка
		Возврат Число(Значение);
	Исключение
		ВызватьИсключение СтрШаблон("Настройка %1 должна быть числом, получено ""%2""", Ключ, Значение);
	КонецПопытки;

КонецФункции

Функция ОбязательнаяНастройка(Ключ)

	Значение = Поделка.НайтиДетальку(Ключ);
	Если Значение = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Для файлового кэша обязательна настройка %1", Ключ);
	КонецЕсли;

	Возврат Значение;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") Контекст)

	Поделка = Контекст;
	Кэши = Новый Соответствие;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
