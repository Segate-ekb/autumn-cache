#Использовать "../internal"
#Использовать logos

// Именованный кэш со сроком жизни записей; предел, очередь вытеснения SLRU и замок — в бюджете,
// своём или общем с другими кэшами в памяти. Чтение и запись данных поставщика идут вне замка.

Перем Имя;
Перем Поставщик;
Перем Бюджет;
Перем СрокЖизниМс;
Перем Записи;
Перем ТекущееПоколение;
Перем Попадания;
Перем Промахи;
Перем Вытеснения;
Перем ВесЗаписей;
Перем Лог;

#Область ПрограммныйИнтерфейс

// Возвращает значение по ключу.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи;
//          одиночное значение равносильно ключу из одной части
//
// Возвращаемое значение:
//   Произвольный - Значение или Неопределено, если записи нет или она истекла
//
Функция Получить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Сегмент = Неопределено;
	Запись = ЗаписьДляЧтения(Текст, Сегмент);
	Значение = ?(Запись = Неопределено, Неопределено, Поставщик.Прочитать(Запись.Данные));

	Бюджет.Замок.Заблокировать();
	Если Значение = Неопределено Тогда
		Промахи = Промахи + 1;
	Иначе
		Попадания = Попадания + 1;
	КонецЕсли;
	Бюджет.Замок.Разблокировать();

	Если Значение <> Неопределено Тогда
		Лог.Отладка("Кэш ""%1"": попадание, ключ %2, вес %3, сегмент %4", Имя, Текст, Запись.Вес, Сегмент);
	ИначеЕсли Запись <> Неопределено Тогда
		Лог.Отладка("Кэш ""%1"": промах, ключ %2, данные записи удалены во время чтения", Имя, Текст);
	Иначе
		Лог.Отладка("Кэш ""%1"": промах, ключ %2", Имя, Текст);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Кладёт значение по ключу, вытесняя записи сверх предела. Неопределено, NULL и значение
// тяжелее допустимой доли предела не кладутся, а прежняя запись ключа при этом удаляется.
// Если во время записи кэш сбросили, значение не кладётся.
//
// Параметры:
//   Ключ     - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//   Значение - Произвольный - Значение; файловый кэш принимает только ДвоичныеДанные,
//              кэш в памяти с пределом в байтах — только неизменяемые значения,
//              иначе вызывается исключение
//
Процедура Положить(Ключ, Значение) Экспорт
	ПоложитьВПоколении(ТекстКлюча(Ключ), Значение, ТекущееПоколение);
КонецПроцедуры

// Удаляет запись по ключу. Значения, которые сейчас пишутся в кэш, после этого не кладутся.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//
Процедура Удалить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Убрать(Записи[Текст], Убранные);
		ТекущееПоколение = ТекущееПоколение + 1;
		НовоеПоколение = ТекущееПоколение;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Лог.Отладка("Кэш ""%1"": сброс, ключ %2, удалено записей %3, поколение %4",
		Имя, Текст, Убранные.Количество(), НовоеПоколение);

КонецПроцедуры

// Удаляет все записи. Значения, которые сейчас пишутся в кэш, после этого не кладутся.
//
Процедура Очистить() Экспорт

	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Для Каждого КлючИЗапись Из Записи Цикл
			Бюджет.Очередь.Убрать(КлючИЗапись.Значение);
			Убранные.Добавить(КлючИЗапись.Значение);
		КонецЦикла;
		Записи = Новый Соответствие;
		ВесЗаписей = 0;
		ТекущееПоколение = ТекущееПоколение + 1;
		НовоеПоколение = ТекущееПоколение;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Лог.Отладка("Кэш ""%1"": очистка, удалено записей %2, поколение %3", Имя, Убранные.Количество(), НовоеПоколение);

КонецПроцедуры

// Счётчики кэша с момента создания.
//
// Возвращаемое значение:
//   Структура - Счётчики:
//     * Попадания  - Число - Значение найдено
//     * Промахи    - Число - Значения не было
//     * Вытеснения - Число - Записи убраны по пределу или сроку жизни
//     * Занято     - Число - Вес записей этого кэша: записи или байты
//
Функция Статистика() Экспорт
	Возврат Новый Структура("Попадания, Промахи, Вытеснения, Занято", Попадания, Промахи, Вытеснения, ВесЗаписей);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Имя кэша.
//
// Возвращаемое значение:
//   Строка - Имя
//
Функция Имя() Экспорт
	Возврат Имя;
КонецФункции

// Поколение кэша: меняется при каждом Удалить и Очистить.
//
// Возвращаемое значение:
//   Число - Номер поколения
//
Функция Поколение() Экспорт
	Возврат ТекущееПоколение;
КонецФункции

// Кладёт результат метода, если с начала вызова кэш не сбрасывали. В отличие от Положить
// не вызывает исключений, сбой пишет в журнал.
//
// Параметры:
//   Ключ            - КлючКэша - Ключ записи
//   Значение        - Произвольный - Результат метода
//   ПоколениеВызова - Число - Поколение кэша на начало вызова метода
//
Процедура Запомнить(Ключ, Значение, ПоколениеВызова) Экспорт

	Текст = ТекстКлюча(Ключ);
	Попытка
		ПоложитьВПоколении(Текст, Значение, ПоколениеВызова);
	Исключение
		Лог.Ошибка("Кэш ""%1"": не положено, ключ %2, %3", Имя, Текст, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Снимает запись этого кэша с индекса и учёта веса; вызывается под замком бюджета,
// в том числе когда запись вытесняет другой кэш общего бюджета.
//
// Параметры:
//   Запись     - Структура - Запись этого кэша
//   Вытеснение - Булево - Засчитать вытеснение
//
Процедура СнятьСУчёта(Запись, Вытеснение) Экспорт

	Записи.Удалить(Запись.Текст);
	ВесЗаписей = ВесЗаписей - Запись.Вес;
	Если Вытеснение Тогда
		Вытеснения = Вытеснения + 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запись ключа для чтения: истёкшая убирается, найденная продвигается в очереди.
// В Сегмент возвращается сегмент, где запись была до обращения.
Функция ЗаписьДляЧтения(Текст, Сегмент)

	Найденная = Неопределено;
	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Запись = Записи[Текст];
		Если Запись <> Неопределено И Истекла(Запись) Тогда
			Убрать(Запись, Убранные, Истина);
		ИначеЕсли Запись <> Неопределено Тогда
			Сегмент = ИмяСегмента(Запись);
			Бюджет.Очередь.Обратиться(Запись);
			Найденная = Запись;
		КонецЕсли;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	Если Убранные.Количество() > 0 Тогда
		УдалитьДанные(Убранные);
		Лог.Отладка("Кэш ""%1"": истекла, ключ %2, срок жизни %3 с", Имя, Текст, СрокЖизниМс / 1000);
	КонецЕсли;

	Возврат Найденная;

КонецФункции

Процедура ПоложитьВПоколении(Текст, Значение, Знач ПоколениеЗаписи)

	Вес = ВесЗаписи(Текст, Значение);
	Если НЕ ЗанятьМесто(Текст, Вес, ПоколениеЗаписи) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = Поставщик.Записать(Значение);
	Исключение
		ОсвободитьМесто(Вес);
		ВызватьИсключение;
	КонецПопытки;

	Истекает = ?(СрокЖизниМс = 0, 0, ТекущаяУниверсальнаяДатаВМиллисекундах() + СрокЖизниМс);
	Опубликовать(Новый Структура("Текст, Данные, Вес, Истекает, Кэш", Текст, Данные, Вес, Истекает, ЭтотОбъект),
		ПоколениеЗаписи);

КонецПроцедуры

// Неопределено, если значение не кладётся: Неопределено, NULL или тяжелее доли предела.
Функция ВесЗаписи(Текст, Значение)

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, значение %3", Имя, Текст, ?(Значение = NULL, "NULL", "Неопределено"));
		Возврат Неопределено;
	КонецЕсли;

	Вес = Поставщик.Вес(Значение, Текст);
	Если Вес > Бюджет.НаибольшийВес Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, вес %3 больше допустимого %4 при пределе %5",
			Имя, Текст, Вес, Бюджет.НаибольшийВес, Бюджет.Предел);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Вес;

КонецФункции

// Убирает прежнюю запись ключа; если значение кладётся и вместе с пишущимися сейчас записями
// укладывается в предел, вытесняет под него записи и резервирует его вес.
// Запись из устаревшего поколения кэш не меняет.
Функция ЗанятьМесто(Текст, Вес, Знач ПоколениеЗаписи)

	Уложился = Ложь;
	Убранные = Новый Массив;
	Вытесненные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		ПоколениеКэша = ТекущееПоколение;
		РезервБюджета = Бюджет.Резерв;
		Если ПоколениеЗаписи = ТекущееПоколение Тогда
			Убрать(Записи[Текст], Убранные);
			Уложился = Вес <> Неопределено И Бюджет.Резерв + Вес <= Бюджет.Предел;
		КонецЕсли;
		Если Уложился Тогда
			Пока Бюджет.Занято() + Вес > Бюджет.Предел Цикл
				Жертва = Бюджет.Очередь.Жертва();
				Если Жертва = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Вытесненные.Добавить(Новый Структура("Запись, Давление", Жертва, Бюджет.Занято() + Вес));
				Убрать(Жертва, Убранные, Истина);
			КонецЦикла;
			Бюджет.Резерв = Бюджет.Резерв + Вес;
		КонецЕсли;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Если ПоколениеЗаписи <> ПоколениеКэша Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, кэш сброшен во время вызова, поколение %3, текущее %4",
			Имя, Текст, ПоколениеЗаписи, ПоколениеКэша);
	ИначеЕсли Вес <> Неопределено И НЕ Уложился Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, вес %3 не помещается рядом с пишущимися, резерв %4, предел %5",
			Имя, Текст, Вес, РезервБюджета, Бюджет.Предел);
	КонецЕсли;
	Для Каждого Вытесненная Из Вытесненные Цикл
		Лог.Отладка("Кэш ""%1"": вытеснение, ключ %2, вес %3, сегмент %4, давление %5 из %6",
			Вытесненная.Запись.Кэш.Имя(), Вытесненная.Запись.Текст, Вытесненная.Запись.Вес,
			ИмяСегмента(Вытесненная.Запись), Вытесненная.Давление, Бюджет.Предел);
	КонецЦикла;

	Возврат Уложился;

КонецФункции

Процедура ОсвободитьМесто(Вес)

	Бюджет.Замок.Заблокировать();
	Бюджет.Резерв = Бюджет.Резерв - Вес;
	Бюджет.Замок.Разблокировать();

КонецПроцедуры

// Снимает резерв и ставит запись на место прежней записи ключа; если кэш сбросили,
// пока запись писалась, её данные удаляются.
Процедура Опубликовать(Запись, Знач ПоколениеЗаписи)

	Опубликована = Ложь;
	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Бюджет.Резерв = Бюджет.Резерв - Запись.Вес;
		ПоколениеКэша = ТекущееПоколение;
		Если ПоколениеЗаписи = ТекущееПоколение Тогда
			Убрать(Записи[Запись.Текст], Убранные);
			Записи.Вставить(Запись.Текст, Запись);
			ВесЗаписей = ВесЗаписей + Запись.Вес;
			Бюджет.Очередь.Добавить(Запись);
			Опубликована = Истина;
		Иначе
			Убранные.Добавить(Запись);
		КонецЕсли;
		ЗанятоБюджета = Бюджет.Занято();
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Если Опубликована Тогда
		Лог.Отладка("Кэш ""%1"": положено, ключ %2, вес %3, занято бюджета %4 из %5",
			Имя, Запись.Текст, Запись.Вес, ЗанятоБюджета, Бюджет.Предел);
	Иначе
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, кэш сброшен во время записи, поколение %3, текущее %4",
			Имя, Запись.Текст, ПоколениеЗаписи, ПоколениеКэша);
	КонецЕсли;

КонецПроцедуры

Процедура Убрать(Знач Запись, Убранные, Вытеснение = Ложь)

	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Запись может принадлежать другому кэшу общего бюджета — с учёта её снимает свой кэш.
	Бюджет.Очередь.Убрать(Запись);
	Запись.Кэш.СнятьСУчёта(Запись, Вытеснение);
	Убранные.Добавить(Запись);

КонецПроцедуры

// Чужие записи общего бюджета — записи кэшей в памяти, их данные удалять не нужно.
Процедура УдалитьДанные(Убранные)

	Для Каждого Запись Из Убранные Цикл
		Поставщик.Удалить(Запись.Данные);
	КонецЦикла;

КонецПроцедуры

Функция ИмяСегмента(Запись)
	Возврат ?(Запись.Защищена, "защищённый", "испытательный");
КонецФункции

Функция Истекла(Запись)
	Возврат Запись.Истекает > 0 И Запись.Истекает <= ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецФункции

Функция ТекстКлюча(Знач Ключ)

	Если ТипЗнч(Ключ) <> Тип("КлючКэша") Тогда
		Ключ = Новый КлючКэша().Добавить(Ключ);
	КонецЕсли;

	Возврат Ключ.Текст();

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(ИмяКэша, ПоставщикКэша, БюджетЗаписей, СрокЖизни)

	Имя = ИмяКэша;
	Поставщик = ПоставщикКэша;
	Бюджет = БюджетЗаписей;
	СрокЖизниМс = СрокЖизни * 1000;

	Записи = Новый Соответствие;
	ТекущееПоколение = 0;
	Попадания = 0;
	Промахи = 0;
	Вытеснения = 0;
	ВесЗаписей = 0;

	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
