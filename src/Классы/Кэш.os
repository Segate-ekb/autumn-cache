#Использовать "../internal"
#Использовать logos

// Именованный кэш с пределом, сроком жизни записей и вытеснением SLRU.
// Индекс записей защищён замком; чтение и запись данных поставщика идут вне замка.

Перем Имя;
Перем Поставщик;
Перем Предел;
Перем НаибольшийВес;
Перем СрокЖизниМс;
Перем Записи;
Перем Очередь;
Перем Резерв;
Перем ТекущееПоколение;
Перем Попадания;
Перем Промахи;
Перем Вытеснения;
Перем Замок;
Перем Лог;

#Область ПрограммныйИнтерфейс

// Возвращает значение по ключу.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи;
//          одиночное значение равносильно ключу из одной части
//
// Возвращаемое значение:
//   Произвольный - Значение или Неопределено, если записи нет или она истекла
//
Функция Получить(Ключ) Экспорт

	Значение = Найденное(ТекстКлюча(Ключ));

	Замок.Заблокировать();
	Если Значение = Неопределено Тогда
		Промахи = Промахи + 1;
	Иначе
		Попадания = Попадания + 1;
	КонецЕсли;
	Замок.Разблокировать();

	Возврат Значение;

КонецФункции

// Кладёт значение по ключу, вытесняя записи сверх предела. Неопределено, NULL и значение
// тяжелее допустимой доли предела не кладутся, а прежняя запись ключа при этом удаляется.
// Если во время записи кэш сбросили, значение не кладётся.
//
// Параметры:
//   Ключ     - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//   Значение - Произвольный - Значение; файловый кэш принимает только ДвоичныеДанные,
//              иначе вызывает исключение
//
Процедура Положить(Ключ, Значение) Экспорт
	ПоложитьВПоколении(ТекстКлюча(Ключ), Значение, ТекущееПоколение);
КонецПроцедуры

// Удаляет запись по ключу. Значения, которые сейчас пишутся в кэш, после этого не кладутся.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//
Процедура Удалить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Убранные = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Убрать(Записи[Текст], Убранные);
		ТекущееПоколение = ТекущееПоколение + 1;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Убранные);

КонецПроцедуры

// Удаляет все записи. Значения, которые сейчас пишутся в кэш, после этого не кладутся.
//
Процедура Очистить() Экспорт

	Убранные = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Для Каждого КлючИЗапись Из Записи Цикл
			Убранные.Добавить(КлючИЗапись.Значение);
		КонецЦикла;
		Записи = Новый Соответствие;
		Очередь = Новый ОчередьВытеснения(Предел);
		ТекущееПоколение = ТекущееПоколение + 1;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Убранные);

КонецПроцедуры

// Счётчики кэша с момента создания.
//
// Возвращаемое значение:
//   Структура - Счётчики:
//     * Попадания  - Число - Значение найдено
//     * Промахи    - Число - Значения не было
//     * Вытеснения - Число - Записи убраны по пределу или сроку жизни
//
Функция Статистика() Экспорт
	Возврат Новый Структура("Попадания, Промахи, Вытеснения", Попадания, Промахи, Вытеснения);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Поколение кэша: меняется при каждом Удалить и Очистить.
//
// Возвращаемое значение:
//   Число - Номер поколения
//
Функция Поколение() Экспорт
	Возврат ТекущееПоколение;
КонецФункции

// Кладёт результат метода, если с начала вызова кэш не сбрасывали. В отличие от Положить
// не вызывает исключений, сбой пишет в журнал.
//
// Параметры:
//   Ключ            - КлючКэша - Ключ записи
//   Значение        - Произвольный - Результат метода
//   ПоколениеВызова - Число - Поколение кэша на начало вызова метода
//
Процедура Запомнить(Ключ, Значение, ПоколениеВызова) Экспорт

	Попытка
		ПоложитьВПоколении(ТекстКлюча(Ключ), Значение, ПоколениеВызова);
	Исключение
		Лог.Ошибка("Кэш ""%1"": результат не сохранён: %2", Имя, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Найденное(Текст)

	Данные = Неопределено;
	Убранные = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Запись = Записи[Текст];
		Если Запись <> Неопределено И Истекла(Запись) Тогда
			Убрать(Запись, Убранные);
			Вытеснения = Вытеснения + 1;
		ИначеЕсли Запись <> Неопределено Тогда
			Очередь.Обратиться(Запись);
			Данные = Запись.Данные;
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Возврат ?(Данные = Неопределено, Неопределено, Поставщик.Прочитать(Данные));

КонецФункции

Процедура ПоложитьВПоколении(Текст, Значение, Знач ПоколениеЗаписи)

	Вес = ВесЗаписи(Значение);
	Если НЕ ЗанятьМесто(Текст, Вес, ПоколениеЗаписи) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = Поставщик.Записать(Значение);
	Исключение
		ОсвободитьМесто(Вес);
		ВызватьИсключение;
	КонецПопытки;

	Истекает = ?(СрокЖизниМс = 0, 0, ТекущаяУниверсальнаяДатаВМиллисекундах() + СрокЖизниМс);
	Опубликовать(Новый Структура("Текст, Данные, Вес, Истекает", Текст, Данные, Вес, Истекает), ПоколениеЗаписи);

КонецПроцедуры

// Неопределено, если значение не кладётся: Неопределено, NULL или тяжелее доли предела.
Функция ВесЗаписи(Значение)

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вес = Поставщик.Вес(Значение);

	Возврат ?(Вес > НаибольшийВес, Неопределено, Вес);

КонецФункции

// Убирает прежнюю запись ключа; если значение кладётся и вместе с пишущимися сейчас записями
// укладывается в предел, вытесняет под него записи и резервирует его вес.
// Запись из устаревшего поколения кэш не меняет.
Функция ЗанятьМесто(Текст, Вес, Знач ПоколениеЗаписи)

	Уложился = Ложь;
	Убранные = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Если ПоколениеЗаписи = ТекущееПоколение Тогда
			Убрать(Записи[Текст], Убранные);
			Уложился = Вес <> Неопределено И Резерв + Вес <= Предел;
		КонецЕсли;
		Если Уложился Тогда
			Пока Очередь.Вес() + Резерв + Вес > Предел Цикл
				Жертва = Очередь.Жертва();
				Если Жертва = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Убрать(Жертва, Убранные);
				Вытеснения = Вытеснения + 1;
			КонецЦикла;
			Резерв = Резерв + Вес;
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Возврат Уложился;

КонецФункции

Процедура ОсвободитьМесто(Вес)

	Замок.Заблокировать();
	Резерв = Резерв - Вес;
	Замок.Разблокировать();

КонецПроцедуры

// Снимает резерв и ставит запись на место прежней записи ключа; если кэш сбросили,
// пока запись писалась, её данные удаляются.
Процедура Опубликовать(Запись, Знач ПоколениеЗаписи)

	Убранные = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Резерв = Резерв - Запись.Вес;
		Если ПоколениеЗаписи = ТекущееПоколение Тогда
			Убрать(Записи[Запись.Текст], Убранные);
			Записи.Вставить(Запись.Текст, Запись);
			Очередь.Добавить(Запись);
		Иначе
			Убранные.Добавить(Запись);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Убранные);

КонецПроцедуры

Процедура Убрать(Знач Запись, Убранные)

	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Записи.Удалить(Запись.Текст);
	Очередь.Убрать(Запись);
	Убранные.Добавить(Запись);

КонецПроцедуры

Процедура УдалитьДанные(Убранные)

	Для Каждого Запись Из Убранные Цикл
		Поставщик.Удалить(Запись.Данные);
	КонецЦикла;

КонецПроцедуры

Функция Истекла(Запись)
	Возврат Запись.Истекает > 0 И Запись.Истекает <= ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецФункции

Функция ТекстКлюча(Знач Ключ)

	Если ТипЗнч(Ключ) <> Тип("КлючКэша") Тогда
		Ключ = Новый КлючКэша().Добавить(Ключ);
	КонецЕсли;

	Возврат Ключ.Текст();

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(ИмяКэша, ПоставщикКэша, ПределКэша, НаибольшийВесЗаписи, СрокЖизни)

	Имя = ИмяКэша;
	Поставщик = ПоставщикКэша;
	Предел = ПределКэша;
	НаибольшийВес = НаибольшийВесЗаписи;
	СрокЖизниМс = СрокЖизни * 1000;

	Записи = Новый Соответствие;
	Очередь = Новый ОчередьВытеснения(Предел);
	Резерв = 0;
	ТекущееПоколение = 0;
	Попадания = 0;
	Промахи = 0;
	Вытеснения = 0;

	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
