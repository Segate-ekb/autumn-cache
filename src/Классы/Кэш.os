#Использовать "../internal"
#Использовать logos

// Именованный кэш с пределом, сроком жизни записей и вытеснением SLRU.
// Индекс записей защищён замком; чтение и запись файлов поставщика идут вне замка.

Перем Имя;
Перем Поставщик;
Перем Предел;
Перем НаибольшийВес;
Перем СрокЖизниМс;
Перем Записи;
Перем Очередь;
Перем Резерв;
Перем Попадания;
Перем Промахи;
Перем Вытеснения;
Перем Замок;
Перем Лог;

#Область ПрограммныйИнтерфейс

// Возвращает значение по ключу.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи;
//          одиночное значение равносильно ключу из одной части
//
// Возвращаемое значение:
//   Произвольный - Значение или Неопределено, если записи нет или она истекла
//
Функция Получить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Истекшие = Новый Массив;
	Данные = Неопределено;

	Замок.Заблокировать();
	Попытка
		Запись = Записи[Текст];
		Если Запись <> Неопределено И Истекла(Запись) Тогда
			Убрать(Запись, Истекшие);
			Вытеснения = Вытеснения + 1;
		ИначеЕсли Запись <> Неопределено Тогда
			Очередь.Обратиться(Запись);
			Данные = Запись.Данные;
		КонецЕсли;
		Если Данные = Неопределено Тогда
			Промахи = Промахи + 1;
		Иначе
			Попадания = Попадания + 1;
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Истекшие);

	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Поставщик.Прочитать(Данные);

КонецФункции

// Кладёт значение по ключу, вытесняя записи сверх предела. Неопределено и NULL не кладутся,
// значение тяжелее допустимой доли предела не кладётся.
//
// Параметры:
//   Ключ     - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//   Значение - Произвольный - Значение; файловый кэш принимает только ДвоичныеДанные,
//              иначе вызывает исключение
//
Процедура Положить(Ключ, Значение) Экспорт

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат;
	КонецЕсли;

	Текст = ТекстКлюча(Ключ);
	Вес = Поставщик.Вес(Значение);
	Если Вес > НаибольшийВес Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗанятьМесто(Текст, Вес) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = Поставщик.Записать(Значение);
	Исключение
		Опубликовать(Неопределено, Вес);
		ВызватьИсключение;
	КонецПопытки;

	Истекает = ?(СрокЖизниМс = 0, 0, ТекущаяУниверсальнаяДатаВМиллисекундах() + СрокЖизниМс);
	Запись = Новый Структура("Текст, Данные, Вес, Истекает, Защищена, Пред, След", Текст, Данные, Вес, Истекает);
	Опубликовать(Запись, Вес);

КонецПроцедуры

// Удаляет запись по ключу.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//
Процедура Удалить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Удалённые = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Убрать(Записи[Текст], Удалённые);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Удалённые);

КонецПроцедуры

// Удаляет все записи.
//
Процедура Очистить() Экспорт

	Удалённые = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Для Каждого КлючИЗапись Из Записи Цикл
			Удалённые.Добавить(КлючИЗапись.Значение);
		КонецЦикла;
		Записи = Новый Соответствие;
		Очередь = Новый ОчередьВытеснения(Предел);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Удалённые);

КонецПроцедуры

// Счётчики кэша с момента создания.
//
// Возвращаемое значение:
//   Структура - Счётчики:
//     * Попадания  - Число - Значение найдено
//     * Промахи    - Число - Значения не было
//     * Вытеснения - Число - Записи убраны по пределу или сроку жизни
//
Функция Статистика() Экспорт
	Возврат Новый Структура("Попадания, Промахи, Вытеснения", Попадания, Промахи, Вытеснения);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Кладёт результат метода; в отличие от Положить не вызывает исключений, сбой пишет в журнал.
//
// Параметры:
//   Ключ     - КлючКэша - Ключ записи
//   Значение - Произвольный - Результат метода
//
Процедура Запомнить(Ключ, Значение) Экспорт

	Попытка
		Положить(Ключ, Значение);
	Исключение
		Лог.Ошибка("Кэш ""%1"": результат не сохранён: %2", Имя, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Убирает прежнюю запись ключа и вытесняет записи, пока новый вес вместе с весом
// пишущихся сейчас записей не уложится в предел; уложившийся вес резервируется.
Функция ЗанятьМесто(Текст, Вес)

	Удалённые = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Убрать(Записи[Текст], Удалённые);
		Пока Очередь.Вес() + Резерв + Вес > Предел Цикл
			Жертва = Очередь.Жертва();
			Если Жертва = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Убрать(Жертва, Удалённые);
			Вытеснения = Вытеснения + 1;
		КонецЦикла;
		Уложился = Очередь.Вес() + Резерв + Вес <= Предел;
		Если Уложился Тогда
			Резерв = Резерв + Вес;
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Удалённые);

	Возврат Уложился;

КонецФункции

// Снимает резерв и, если запись есть, ставит её на место прежней записи того же ключа.
Процедура Опубликовать(Запись, Вес)

	Удалённые = Новый Массив;

	Замок.Заблокировать();
	Попытка
		Резерв = Резерв - Вес;
		Если Запись <> Неопределено Тогда
			Убрать(Записи[Запись.Текст], Удалённые);
			Записи.Вставить(Запись.Текст, Запись);
			Очередь.Добавить(Запись);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	УдалитьДанные(Удалённые);

КонецПроцедуры

Процедура Убрать(Знач Запись, Удалённые)

	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Записи.Удалить(Запись.Текст);
	Очередь.Убрать(Запись);
	Удалённые.Добавить(Запись);

КонецПроцедуры

Процедура УдалитьДанные(Удалённые)

	Для Каждого Запись Из Удалённые Цикл
		Поставщик.Удалить(Запись.Данные);
	КонецЦикла;

КонецПроцедуры

Функция Истекла(Запись)
	Возврат Запись.Истекает > 0 И Запись.Истекает <= ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецФункции

Функция ТекстКлюча(Знач Ключ)

	Если ТипЗнч(Ключ) <> Тип("КлючКэша") Тогда
		Ключ = Новый КлючКэша().Добавить(Ключ);
	КонецЕсли;

	Возврат Ключ.Текст();

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(ИмяКэша, ПоставщикКэша, ПределКэша, НаибольшийВесЗаписи, СрокЖизни)

	Имя = ИмяКэша;
	Поставщик = ПоставщикКэша;
	Предел = ПределКэша;
	НаибольшийВес = НаибольшийВесЗаписи;
	СрокЖизниМс = СрокЖизни * 1000;

	Записи = Новый Соответствие;
	Очередь = Новый ОчередьВытеснения(Предел);
	Резерв = 0;
	Попадания = 0;
	Промахи = 0;
	Вытеснения = 0;

	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
