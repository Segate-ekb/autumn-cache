#Использовать "../internal"
#Использовать logos

// Именованный кэш значений и потоков со сроком жизни записей; предел, очередь вытеснения SLRU и замок —
// в бюджете, своём или общем с другими кэшами в памяти. Данные поставщика читаются и пишутся вне замка.

Перем Имя;
Перем Поставщик;
Перем Бюджет;
Перем СрокЖизниМс;
Перем Записи;
Перем ТекущееПоколение;
Перем Попадания;
Перем Промахи;
Перем Вытеснения;
Перем ВесЗаписей;
Перем Лог;

#Область ПрограммныйИнтерфейс

// Возвращает значение по ключу.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи;
//          одиночное значение равносильно ключу из одной части
//
// Возвращаемое значение:
//   Произвольный - Значение, для потоковой записи — новый поток над ней; Неопределено,
//                  если записи нет или она истекла
//
Функция Получить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Сегмент = Неопределено;
	Запись = ЗаписьДляЧтения(Текст, Сегмент);
	Значение = ?(Запись = Неопределено, Неопределено, ЗначениеЗаписи(Запись));

	Бюджет.Замок.Заблокировать();
	Если Значение = Неопределено Тогда
		Промахи = Промахи + 1;
	Иначе
		Попадания = Попадания + 1;
	КонецЕсли;
	Бюджет.Замок.Разблокировать();

	Если Значение <> Неопределено Тогда
		Лог.Отладка("Кэш ""%1"": попадание, ключ %2, вес %3, сегмент %4", Имя, Текст, Запись.Вес, Сегмент);
	ИначеЕсли Запись <> Неопределено Тогда
		Лог.Отладка("Кэш ""%1"": промах, ключ %2, данные записи удалены во время чтения", Имя, Текст);
	Иначе
		Лог.Отладка("Кэш ""%1"": промах, ключ %2", Имя, Текст);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Кладёт значение по ключу, вытесняя записи сверх предела. Неопределено, NULL и значение
// тяжелее допустимой доли предела не кладутся, а прежняя запись ключа при этом удаляется.
// Если во время записи кэш сбросили, значение не кладётся. Поток кэш вычитывает от текущей
// позиции в запись и закрывает; поток, который не положен, остаётся нетронутым.
//
// Параметры:
//   Ключ     - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//   Значение - Произвольный - Значение или поток (Поток, ФайловыйПоток, ПотокВПамяти);
//              файловый кэш принимает только ДвоичныеДанные и потоки с изменением позиции,
//              кэш в памяти с пределом в байтах — только неизменяемые значения и потоки
//              с изменением позиции, иначе вызывается исключение
//
// Возвращаемое значение:
//   Произвольный - Значение к выдаче: для положенного потока — новый поток над записью,
//                  иначе само значение
//
Функция Положить(Ключ, Значение) Экспорт
	Возврат ПоложитьВПоколении(ТекстКлюча(Ключ), Значение, ТекущееПоколение);
КонецФункции

// Отдаёт кэшу готовый файл под ключ как потоковую запись: файловый кэш забирает его перемещением,
// без копии, кэш в памяти вычитывает в ДвоичныеДанные и удаляет. Файл, которого нет или который
// тяжелее допустимой доли предела, не кладётся, а прежняя запись ключа при этом удаляется.
// При сбое перемещения или чтения вызывается исключение, а файл остаётся на месте.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//   Путь - Строка - Путь к файлу
//
// Возвращаемое значение:
//   Булево - Истина, если файл теперь принадлежит кэшу: если кэш сбросили, пока файл переносился,
//            запись не появится, а файл кэш удалит. Ложь, если файл не положен и остался у вызывающего
//            нетронутым: его нет, он тяжелее доли предела, не помещается рядом с пишущимися записями
//            или кэш сбросили до переноса
//
Функция ПоложитьФайл(Ключ, Путь) Экспорт

	Текст = ТекстКлюча(Ключ);
	ПоколениеЗаписи = ТекущееПоколение;
	Вес = ВесЗаписиФайла(Текст, Путь);
	Если НЕ ЗанятьМесто(Текст, Вес, ПоколениеЗаписи) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Данные = Поставщик.ЗабратьФайл(Путь);
	Исключение
		ОсвободитьМесто(Вес);
		ВызватьИсключение;
	КонецПопытки;

	Опубликовать(НоваяЗапись(Текст, Данные, Истина, Вес), ПоколениеЗаписи);

	Возврат Истина;

КонецФункции

// Удаляет запись по ключу. Значения, которые сейчас пишутся в кэш, после этого не кладутся.
//
// Параметры:
//   Ключ - КлючКэша, Строка, Число, Дата, Булево, УникальныйИдентификатор - Ключ записи
//
Процедура Удалить(Ключ) Экспорт

	Текст = ТекстКлюча(Ключ);
	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Убрать(Записи[Текст], Убранные);
		ТекущееПоколение = ТекущееПоколение + 1;
		НовоеПоколение = ТекущееПоколение;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Лог.Отладка("Кэш ""%1"": сброс, ключ %2, удалено записей %3, поколение %4",
		Имя, Текст, Убранные.Количество(), НовоеПоколение);

КонецПроцедуры

// Удаляет все записи. Значения, которые сейчас пишутся в кэш, после этого не кладутся.
//
Процедура Очистить() Экспорт

	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Для Каждого КлючИЗапись Из Записи Цикл
			Бюджет.Очередь.Убрать(КлючИЗапись.Значение);
			Убранные.Добавить(КлючИЗапись.Значение);
		КонецЦикла;
		Записи = Новый Соответствие;
		ВесЗаписей = 0;
		ТекущееПоколение = ТекущееПоколение + 1;
		НовоеПоколение = ТекущееПоколение;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Лог.Отладка("Кэш ""%1"": очистка, удалено записей %2, поколение %3", Имя, Убранные.Количество(), НовоеПоколение);

КонецПроцедуры

// Счётчики кэша с момента создания.
//
// Возвращаемое значение:
//   Структура - Счётчики:
//     * Попадания  - Число - Значение найдено
//     * Промахи    - Число - Значения не было
//     * Вытеснения - Число - Записи убраны по пределу или сроку жизни
//     * Занято     - Число - Вес записей этого кэша: записи или байты
//
Функция Статистика() Экспорт
	Возврат Новый Структура("Попадания, Промахи, Вытеснения, Занято", Попадания, Промахи, Вытеснения, ВесЗаписей);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Имя кэша.
//
// Возвращаемое значение:
//   Строка - Имя
//
Функция Имя() Экспорт
	Возврат Имя;
КонецФункции

// Поколение кэша: меняется при каждом Удалить и Очистить.
//
// Возвращаемое значение:
//   Число - Номер поколения
//
Функция Поколение() Экспорт
	Возврат ТекущееПоколение;
КонецФункции

// Кладёт результат метода, если с начала вызова кэш не сбрасывали. В отличие от Положить
// сбой пишет в журнал и отдаёт результат как есть; исключение вызывается, только если поток
// вычитан при сбое и вернуть его на прежнюю позицию нельзя.
//
// Параметры:
//   Ключ            - КлючКэша - Ключ записи
//   Значение        - Произвольный - Результат метода
//   ПоколениеВызова - Число - Поколение кэша на начало вызова метода
//
// Возвращаемое значение:
//   Произвольный - Результат к выдаче вызывающему: для положенного потока — новый поток над записью,
//                  иначе сам результат
//
Функция Запомнить(Ключ, Значение, ПоколениеВызова) Экспорт

	Текст = ТекстКлюча(Ключ);
	Выдача = Значение;
	ИсходныйЦел = Истина;
	Попытка
		Выдача = ПоложитьВПоколении(Текст, Значение, ПоколениеВызова, ИсходныйЦел);
	Исключение
		Лог.Ошибка("Кэш ""%1"": не положено, ключ %2, %3", Имя, Текст, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		// Поток с середины отдал бы вызывающему урезанные данные.
		Если НЕ ИсходныйЦел Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;

	Возврат Выдача;

КонецФункции

// Снимает запись этого кэша с индекса и учёта веса; вызывается под замком бюджета,
// в том числе когда запись вытесняет другой кэш общего бюджета.
//
// Параметры:
//   Запись     - Структура - Запись этого кэша
//   Вытеснение - Булево - Засчитать вытеснение
//
Процедура СнятьСУчёта(Запись, Вытеснение) Экспорт

	Записи.Удалить(Запись.Текст);
	ВесЗаписей = ВесЗаписей - Запись.Вес;
	Если Вытеснение Тогда
		Вытеснения = Вытеснения + 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запись ключа для чтения: истёкшая убирается, найденная продвигается в очереди.
// В Сегмент возвращается сегмент, где запись была до обращения.
Функция ЗаписьДляЧтения(Текст, Сегмент)

	Найденная = Неопределено;
	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Запись = Записи[Текст];
		Если Запись <> Неопределено И Истекла(Запись) Тогда
			Убрать(Запись, Убранные, Истина);
		ИначеЕсли Запись <> Неопределено Тогда
			Сегмент = ИмяСегмента(Запись);
			Бюджет.Очередь.Обратиться(Запись);
			Найденная = Запись;
		КонецЕсли;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	Если Убранные.Количество() > 0 Тогда
		УдалитьДанные(Убранные);
		Лог.Отладка("Кэш ""%1"": истекла, ключ %2, срок жизни %3 с", Имя, Текст, СрокЖизниМс / 1000);
	КонецЕсли;

	Возврат Найденная;

КонецФункции

// Возвращает значение к выдаче: положенный поток закрывается, вместо него выдаётся поток над записью.
// При сбое записи данные удаляются, а поток возвращается на прежнюю позицию; ИсходныйЦел — Ложь,
// если поток без изменения позиции уже вычитан и вернуть его нельзя.
Функция ПоложитьВПоколении(Текст, Значение, Знач ПоколениеЗаписи, ИсходныйЦел = Истина)

	Потоковая = ЭтоПоток(Значение);
	Вес = ВесЗаписи(Текст, Значение, Потоковая);
	Если НЕ ЗанятьМесто(Текст, Вес, ПоколениеЗаписи) Тогда
		Возврат Значение;
	КонецЕсли;

	Начало = ?(Потоковая И Значение.ДоступноИзменениеПозиции, Значение.ТекущаяПозиция(), Неопределено);
	Данные = Неопределено;
	Попытка
		Если Потоковая Тогда
			Данные = Поставщик.ЗаписатьПоток(Значение);
			Выдача = ПотокНадЗаписью(Данные);
			Значение.Закрыть();
		Иначе
			Данные = Поставщик.Записать(Значение);
			Выдача = Значение;
		КонецЕсли;
	Исключение
		ОсвободитьМесто(Вес);
		Если Данные <> Неопределено Тогда
			Поставщик.Удалить(Данные);
		КонецЕсли;
		Если Потоковая Тогда
			ИсходныйЦел = ВернутьНаМесто(Значение, Начало);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Опубликовать(НоваяЗапись(Текст, Данные, Потоковая, Вес), ПоколениеЗаписи);

	Возврат Выдача;

КонецФункции

// Открывается до публикации записи: опубликованную запись может тут же вытеснить соседний вызов.
Функция ПотокНадЗаписью(Данные)

	Поток = Поставщик.ОткрытьПоток(Данные);
	Если Поток = Неопределено Тогда
		ВызватьИсключение "поток над записью не открылся сразу после записи";
	КонецЕсли;

	Возврат Поток;

КонецФункции

// Ложь, если поток не умеет менять позицию: вычитанное из него уже не вернуть.
Функция ВернутьНаМесто(Поток, Начало)

	Если Начало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Поток.Перейти(Начало, ПозицияВПотоке.Начало);

	Возврат Истина;

КонецФункции

Функция НоваяЗапись(Текст, Данные, Потоковая, Вес)

	Истекает = ?(СрокЖизниМс = 0, 0, ТекущаяУниверсальнаяДатаВМиллисекундах() + СрокЖизниМс);

	Возврат Новый Структура("Текст, Данные, Потоковая, Вес, Истекает, Кэш",
		Текст, Данные, Потоковая, Вес, Истекает, ЭтотОбъект);

КонецФункции

// Неопределено, если значение не кладётся: Неопределено, NULL или тяжелее доли предела.
Функция ВесЗаписи(Текст, Значение, Потоковая)

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, значение %3", Имя, Текст, ?(Значение = NULL, "NULL", "Неопределено"));
		Возврат Неопределено;
	КонецЕсли;

	Если Потоковая Тогда
		Вес = Поставщик.ВесПотока(ОстатокПотока(Значение), Текст);
	Иначе
		Вес = Поставщик.Вес(Значение, Текст);
	КонецЕсли;

	Возврат ДопустимыйВес(Текст, Вес);

КонецФункции

// Неопределено, если файл не кладётся: его нет или он тяжелее доли предела.
Функция ВесЗаписиФайла(Текст, Путь)

	Файл = Новый Файл(Путь);
	Если НЕ (Файл.Существует() И Файл.ЭтоФайл()) Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, файла %3 нет", Имя, Текст, Путь);
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДопустимыйВес(Текст, Поставщик.ВесПотока(Файл.Размер(), Текст));

КонецФункции

// Байт от текущей позиции до конца; Неопределено, если поток не умеет менять позицию и размера не знает.
Функция ОстатокПотока(Поток)
	Возврат ?(Поток.ДоступноИзменениеПозиции, Поток.Размер() - Поток.ТекущаяПозиция(), Неопределено);
КонецФункции

// Неопределено, если запись тяжелее доли предела.
Функция ДопустимыйВес(Текст, Вес)

	Если Вес > Бюджет.НаибольшийВес Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, вес %3 больше допустимого %4 при пределе %5",
			Имя, Текст, Вес, Бюджет.НаибольшийВес, Бюджет.Предел);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Вес;

КонецФункции

// Убирает прежнюю запись ключа; если значение кладётся и вместе с пишущимися сейчас записями
// укладывается в предел, вытесняет под него записи и резервирует его вес.
// Запись из устаревшего поколения кэш не меняет.
Функция ЗанятьМесто(Текст, Вес, Знач ПоколениеЗаписи)

	Уложился = Ложь;
	Убранные = Новый Массив;
	Вытесненные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		ПоколениеКэша = ТекущееПоколение;
		РезервБюджета = Бюджет.Резерв;
		Если ПоколениеЗаписи = ТекущееПоколение Тогда
			Убрать(Записи[Текст], Убранные);
			Уложился = Вес <> Неопределено И Бюджет.Резерв + Вес <= Бюджет.Предел;
		КонецЕсли;
		Если Уложился Тогда
			Пока Бюджет.Занято() + Вес > Бюджет.Предел Цикл
				Жертва = Бюджет.Очередь.Жертва();
				Если Жертва = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Вытесненные.Добавить(Новый Структура("Запись, Давление", Жертва, Бюджет.Занято() + Вес));
				Убрать(Жертва, Убранные, Истина);
			КонецЦикла;
			Бюджет.Резерв = Бюджет.Резерв + Вес;
		КонецЕсли;
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Если ПоколениеЗаписи <> ПоколениеКэша Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, кэш сброшен во время вызова, поколение %3, текущее %4",
			Имя, Текст, ПоколениеЗаписи, ПоколениеКэша);
	ИначеЕсли Вес <> Неопределено И НЕ Уложился Тогда
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, вес %3 не помещается рядом с пишущимися, резерв %4, предел %5",
			Имя, Текст, Вес, РезервБюджета, Бюджет.Предел);
	КонецЕсли;
	Для Каждого Вытесненная Из Вытесненные Цикл
		Лог.Отладка("Кэш ""%1"": вытеснение, ключ %2, вес %3, сегмент %4, давление %5 из %6",
			Вытесненная.Запись.Кэш.Имя(), Вытесненная.Запись.Текст, Вытесненная.Запись.Вес,
			ИмяСегмента(Вытесненная.Запись), Вытесненная.Давление, Бюджет.Предел);
	КонецЦикла;

	Возврат Уложился;

КонецФункции

Процедура ОсвободитьМесто(Вес)

	Бюджет.Замок.Заблокировать();
	Бюджет.Резерв = Бюджет.Резерв - Вес;
	Бюджет.Замок.Разблокировать();

КонецПроцедуры

// Снимает резерв и ставит запись на место прежней записи ключа; если кэш сбросили,
// пока запись писалась, её данные удаляются.
Процедура Опубликовать(Запись, Знач ПоколениеЗаписи)

	Опубликована = Ложь;
	Убранные = Новый Массив;

	Бюджет.Замок.Заблокировать();
	Попытка
		Бюджет.Резерв = Бюджет.Резерв - Запись.Вес;
		ПоколениеКэша = ТекущееПоколение;
		Если ПоколениеЗаписи = ТекущееПоколение Тогда
			Убрать(Записи[Запись.Текст], Убранные);
			Записи.Вставить(Запись.Текст, Запись);
			ВесЗаписей = ВесЗаписей + Запись.Вес;
			Бюджет.Очередь.Добавить(Запись);
			Опубликована = Истина;
		Иначе
			Убранные.Добавить(Запись);
		КонецЕсли;
		ЗанятоБюджета = Бюджет.Занято();
	Исключение
		Бюджет.Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Бюджет.Замок.Разблокировать();

	УдалитьДанные(Убранные);

	Если Опубликована Тогда
		Лог.Отладка("Кэш ""%1"": положено, ключ %2, вес %3, занято бюджета %4 из %5",
			Имя, Запись.Текст, Запись.Вес, ЗанятоБюджета, Бюджет.Предел);
	Иначе
		Лог.Отладка("Кэш ""%1"": не положено, ключ %2, кэш сброшен во время записи, поколение %3, текущее %4",
			Имя, Запись.Текст, ПоколениеЗаписи, ПоколениеКэша);
	КонецЕсли;

КонецПроцедуры

Процедура Убрать(Знач Запись, Убранные, Вытеснение = Ложь)

	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Запись может принадлежать другому кэшу общего бюджета — с учёта её снимает свой кэш.
	Бюджет.Очередь.Убрать(Запись);
	Запись.Кэш.СнятьСУчёта(Запись, Вытеснение);
	Убранные.Добавить(Запись);

КонецПроцедуры

// Чужие записи общего бюджета — записи кэшей в памяти, их данные удалять не нужно.
Процедура УдалитьДанные(Убранные)

	Для Каждого Запись Из Убранные Цикл
		Поставщик.Удалить(Запись.Данные);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеЗаписи(Запись)
	Возврат ?(Запись.Потоковая, Поставщик.ОткрытьПоток(Запись.Данные), Поставщик.Прочитать(Запись.Данные));
КонецФункции

Функция ЭтоПоток(Значение)

	Тип = ТипЗнч(Значение);

	Возврат Тип = Тип("Поток") ИЛИ Тип = Тип("ФайловыйПоток") ИЛИ Тип = Тип("ПотокВПамяти");

КонецФункции

Функция ИмяСегмента(Запись)
	Возврат ?(Запись.Защищена, "защищённый", "испытательный");
КонецФункции

Функция Истекла(Запись)
	Возврат Запись.Истекает > 0 И Запись.Истекает <= ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецФункции

Функция ТекстКлюча(Знач Ключ)

	Если ТипЗнч(Ключ) <> Тип("КлючКэша") Тогда
		Ключ = Новый КлючКэша().Добавить(Ключ);
	КонецЕсли;

	Возврат Ключ.Текст();

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(ИмяКэша, ПоставщикКэша, БюджетЗаписей, СрокЖизни)

	Имя = ИмяКэша;
	Поставщик = ПоставщикКэша;
	Бюджет = БюджетЗаписей;
	СрокЖизниМс = СрокЖизни * 1000;

	Записи = Новый Соответствие;
	ТекущееПоколение = 0;
	Попадания = 0;
	Промахи = 0;
	Вытеснения = 0;
	ВесЗаписей = 0;

	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");

КонецПроцедуры
