КонецПроцедуры

&Тест
Процедура ИмяКэшаСТочкойОтвергается() Экспорт

	Менеджер = НоваяПоделка().НайтиЖелудь("МенеджерКэшей");

	Попытка
		Менеджер.Кэш("с.точкой");
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("без точек");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение для имени с точкой";

КонецПроцедуры

Функция Дождаться(Затвор, Признак)

	Для Номер = 1 По 500 Цикл
		Если Затвор[Признак] Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Бюджет из окружения приходит строкой; у кэша «свой» — предел в записях.
Функция НастройкиОбщегоБюджета()

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.ПределПамяти", "100000");
	Настройки.Вставить("cache.свой.Предел", 5);

	Возврат Настройки;

КонецФункции

Функция НоваяПоделка(Знач Настройки = Неопределено)

	Если Настройки = Неопределено Тогда
		Настройки = Новый Соответствие;
		Настройки.Вставить("cache.малый.Предел", 2);
		Настройки.Вставить("cache.документы.Поставщик", "файлы");
		Настройки.Вставить("cache.документы.Предел", 1000);
		Настройки.Вставить("cache.документы.Каталог", Каталог);
	КонецЕсли;

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Настройки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

Процедура ПроверитьОшибкуНастроек(Параметр, Значение, ОжидаемыйТекст)

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.проверка." + Параметр, Значение);
	ПроверитьОшибкуСборки("ЖелудьСКэшемПроверки", Настройки, ОжидаемыйТекст);

КонецПроцедуры

// ОСень не выпускает исключение сборки желудя наружу: пишет его в журнал и отдаёт Неопределено.
// Поэтому текст ошибки проверяется вызовом напильника напрямую.
Процедура ПроверитьОшибкуСборки(ИмяЖелудя, Настройки, ОжидаемыйТекст)

	Поделка = НоваяПоделка(Настройки);
	Ожидаем.Что(Поделка.НайтиЖелудь(ИмяЖелудя)).Равно(Неопределено);

	Напильник = Поделка.НайтиЖелудь("НапильникКэша");
	Определение = Поделка.ПолучитьОпределениеЖелудя(ИмяЖелудя);

	Попытка
		Напильник.ОбработатьЖелудь(Новый(Определение.ТипЖелудя()), Определение);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
		Возврат;
	КонецПопытки;

	ВызватьИсключение СтрШаблон("Ожидалась ошибка сборки желудя %1: %2", ИмяЖелудя, ОжидаемыйТекст);

КонецПроцедуры
