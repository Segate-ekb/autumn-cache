КонецПроцедуры

&Тест
Процедура ФайловыйКэшХранитДвоичныеДанные() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");

	Для Номер = 1 По 2 Цикл
		Ожидаем.Что(Сервис.Документ(100).Размер()).Равно(100);
		Ожидаем.Что(Сервис.Документ(101).Размер()).Равно(101);
		Ожидаем.Что(Сервис.ТекстДокумента("ключ")).Равно("текст");
	КонецЦикла;

	// 100 байт — ровно десятая доля предела и кэшируется; 101 байт и строка — нет.
	Ожидаем.Что(Сервис.Вызовов("Документ")).Равно(3);
	Ожидаем.Что(Сервис.Вызовов("ТекстДокумента")).Равно(2);
	Ожидаем.Что(НайтиФайлы(Каталог, "*.cache").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ОшибкиНастроекПроявляютсяПриСборкеЖелудя() Экспорт

	ПроверитьОшибкуНастроек("Поставщик", "облако", "Неизвестный поставщик кэша");
	ПроверитьОшибкуНастроек("Поставщик", "файлы", "обязательна настройка cache.проверка.Предел");
	ПроверитьОшибкуНастроек("Предел", 0, "Настройка cache.проверка.Предел должна быть больше нуля");
	ПроверитьОшибкуНастроек("Предел", "много", "Настройка cache.проверка.Предел должна быть числом");

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.проверка.Поставщик", "файлы");
	Настройки.Вставить("cache.проверка.Предел", 1000);
	ПроверитьОшибкуСборки("ЖелудьСКэшемПроверки", Настройки, "обязательна настройка cache.проверка.Каталог");

КонецПроцедуры

&Тест
Процедура НеверныеНастройкиНеОчищаютКаталог() Экспорт

	СоздатьКаталог(Каталог);
	СтарыйФайл = ОбъединитьПути(Каталог, "старая-запись.cache");
	ПолучитьДвоичныеДанныеИзСтроки("старое").Записать(СтарыйФайл);

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.проверка.Поставщик", "файлы");
	Настройки.Вставить("cache.проверка.Предел", 0);
	Настройки.Вставить("cache.проверка.Каталог", Каталог);
	ПроверитьОшибкуСборки("ЖелудьСКэшемПроверки", Настройки, "Настройка cache.проверка.Предел должна быть больше нуля");

	Ожидаем.Что(Новый Файл(СтарыйФайл).Существует()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбросНаНеэкспортномМетодеОтвергаетсяПриСборкеЖелудя() Экспорт
	ПроверитьОшибкуСборки("ЖелудьСоСбросомНаНеэкспортном", Новый Соответствие,
		"&СбрасываетКэш на ЖелудьСоСбросомНаНеэкспортном.Забыть: метод должен быть экспортным");
КонецПроцедуры

&Тест
Процедура СбросВоВремяВыполненияМетодаНеПерекрываетсяРезультатом() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");
	Затвор = Новый Структура("Открыт, МетодНачался", Ложь, Ложь);
	Сервис.УстановитьЗатвор(Затвор);

	Параметры = Новый Массив;
	Параметры.Добавить("ключ");
	Задание = ФоновыеЗадания.Выполнить(Сервис, "Медленное", Параметры);
	Ожидаем.Что(Дождаться(Затвор, "МетодНачался")).ЭтоИстина();

	Сервис.ЗабытьМедленное("ключ");
	Затвор.Открыт = Истина;
	Ожидаем.Что(Задание.ОжидатьЗавершения(5000)).ЭтоИстина();

	Сервис.Медленное("ключ");
	Ожидаем.Что(Сервис.Вызовов("Медленное")).Равно(2);

КонецПроцедуры

&Тест
Процедура КэшируемаяПроцедураОтвергаетсяПриСборкеЖелудя() Экспорт
	ПроверитьОшибкуСборки("ЖелудьСКэшируемойПроцедурой", Новый Соответствие, "кэшировать можно только функцию");
КонецПроцедуры

&Тест
Процедура КэшиБезСвоегоПределаДелятОбщийБюджетПамяти() Экспорт

	Менеджер = НоваяПоделка(НастройкиОбщегоБюджета()).НайтиЖелудь("МенеджерКэшей");
	ОбщийА = Менеджер.Кэш("общий");
	ОбщийБ = Менеджер.Кэш("другой общий");

	// Запись числа весит около 1850 байт, в бюджет 100000 входит около 54 записей:
	// записи второго кэша вытесняют старейшие записи первого.
	Для Номер = 1 По 40 Цикл
		ОбщийА.Положить(Номер, Номер);
	КонецЦикла;
	Для Номер = 1 По 20 Цикл
		ОбщийБ.Положить(Номер, Номер);
	КонецЦикла;

	Ожидаем.Что(ОбщийА.Статистика().Вытеснения).Больше(0);
	Ожидаем.Что(ОбщийА.Статистика().Занято + ОбщийБ.Статистика().Занято).Не_().Больше(100000);

КонецПроцедуры

&Тест
Процедура КэшСоСвоимПределомОстаётсяВЗаписях() Экспорт

	Менеджер = НоваяПоделка(НастройкиОбщегоБюджета()).НайтиЖелудь("МенеджерКэшей");

	Менеджер.Кэш("свой").Положить("ключ", Новый Структура);

	Ожидаем.Что(Менеджер.Кэш("свой").Получить("ключ")).Не_().Равно(Неопределено);
	Ожидаем.Что(Менеджер.Кэш("свой").Статистика().Занято).Равно(1);

КонецПроцедуры

