#Использовать ".."
#Использовать "fixtures"
#Использовать autumn
#Использовать asserts

// Аннотации кэша на живой поделке: ключ, сброс, настройки по имени, соседний напильник.

Перем Каталог;

&ПередКаждым
Процедура СоздатьИмяКаталога() Экспорт
	Каталог = ПолучитьИмяВременногоФайла("autumn-cache");
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьКаталог() Экспорт
	УдалитьФайлы(Каталог);
КонецПроцедуры

&Тест
Процедура ПовторныйВызовСТемЖеКлючомНеВызываетМетод() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");

	Первый = Сервис.Настройка("пул", "имя", "первый контекст");
	Второй = Сервис.Настройка("пул", "имя", "второй контекст");
	Сервис.Настройка("пул", "другое имя", "первый контекст");

	Ожидаем.Что(Второй).Равно(Первый);
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(2);

КонецПроцедуры

&Тест
Процедура ИсключениеИНеопределеноНеКэшируются() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");

	Для Номер = 1 По 2 Цикл
		Попытка
			Сервис.Сбойное("ключ");
		Исключение
			Ожидаем.Что(ОписаниеОшибки()).Содержит("Сбой исходного метода");
		КонецПопытки;
		Ожидаем.Что(Сервис.Пустое("ключ")).Равно(Неопределено);
	КонецЦикла;

	Ожидаем.Что(Сервис.Вызовов("Сбойное")).Равно(2);
	Ожидаем.Что(Сервис.Вызовов("Пустое")).Равно(2);

КонецПроцедуры

&Тест
Процедура СоседВидитПередИПослеНаПромахеИПопадании() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");
	Журнал = Поделка.НайтиЖелудь("НапильникСвидетель").Журнал;

	Сервис.Настройка("пул", "имя", "");
	Сервис.Настройка("пул", "имя", "");

	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(1);
	Ожидаем.Что(СтрСоединить(Журнал, ",")).Равно("Перед,После,Перед,После");

КонецПроцедуры

&Тест
Процедура ОбъектВКлючеПроходитЧерезПослеВызоваИсключенияСоседа() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");
	Журнал = Поделка.НайтиЖелудь("НапильникСвидетель").Журнал;

	Попытка
		Сервис.ПоОбъекту(Новый Структура);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не может быть частью ключа кэша");
	КонецПопытки;

	Ожидаем.Что(Сервис.Вызовов("ПоОбъекту")).Равно(0);
	Ожидаем.Что(СтрСоединить(Журнал, ",")).Равно("Перед,ПослеВызоваИсключения");

КонецПроцедуры

&Тест
Процедура СбросПоКлючуИВсехЗаписей() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");
	Сервис.Настройка("пул", "а", "");
	Сервис.Настройка("пул", "б", "");

	Сервис.ЗабытьНастройку("пул", "а", "причина");
	Сервис.Настройка("пул", "а", "");
	Сервис.Настройка("пул", "б", "");
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(3);

	Поделка.НайтиЖелудь("МенеджерКэшей").Кэш("настройки").Удалить(Новый КлючКэша().Добавить("пул").Добавить("б"));
	Сервис.Настройка("пул", "б", "");
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(4);

	Сервис.ЗабытьВсеНастройки();
	Сервис.Настройка("пул", "а", "");
	Сервис.Настройка("пул", "б", "");
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(6);

КонецПроцедуры

&Тест
Процедура СбросНеВыполняетсяПриИсключении() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");
	Сервис.Настройка("пул", "имя", "");

	Попытка
		Сервис.НеудачноЗабыть("пул", "имя");
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Сбой при сбросе");
	КонецПопытки;
	Сервис.Настройка("пул", "имя", "");

	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(1);

КонецПроцедуры

&Тест
Процедура НесколькоСбросовНаОдномМетоде() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");
	Сервис.Малое(1);
	Сервис.БезНастроек(1);

	Сервис.ЗабытьНомер(1);
	Сервис.Малое(1);
	Сервис.БезНастроек(1);

	Ожидаем.Что(Сервис.Вызовов("Малое")).Равно(2);
	Ожидаем.Что(Сервис.Вызовов("БезНастроек")).Равно(2);

КонецПроцедуры

&Тест
Процедура НастройкиКэшаЧитаютсяПоИмени() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");

	Для Номер = 1 По 3 Цикл
		Сервис.Малое(Номер);
	КонецЦикла;
	Сервис.Малое(1);
	Ожидаем.Что(Сервис.Вызовов("Малое")).Равно(4);

	Для Номер = 1 По 1001 Цикл
		Сервис.БезНастроек(Номер);
	КонецЦикла;
	Статистика = Поделка.НайтиЖелудь("МенеджерКэшей").Кэш("безНастроек").Статистика();
	Ожидаем.Что(Статистика.Вытеснения).Равно(1);

КонецПроцедуры

&Тест
Процедура ФайловыйКэшХранитДвоичныеДанные() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");

	Для Номер = 1 По 2 Цикл
		Ожидаем.Что(Сервис.Артефакт(100).Размер()).Равно(100);
		Ожидаем.Что(Сервис.Артефакт(101).Размер()).Равно(101);
		Ожидаем.Что(Сервис.ТекстАртефакта("ключ")).Равно("текст");
	КонецЦикла;

	// 100 байт — ровно десятая доля предела и кэшируется; 101 байт и строка — нет.
	Ожидаем.Что(Сервис.Вызовов("Артефакт")).Равно(3);
	Ожидаем.Что(Сервис.Вызовов("ТекстАртефакта")).Равно(2);
	Ожидаем.Что(НайтиФайлы(Каталог, "*.cache").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ОшибкиНастроекПроявляютсяПриСборкеЖелудя() Экспорт

	ПроверитьОшибкуНастроек("Поставщик", "облако", "Неизвестный поставщик кэша");
	ПроверитьОшибкуНастроек("Поставщик", "файлы", "обязательна настройка cache.проверка.Предел");
	ПроверитьОшибкуНастроек("Предел", 0, "Предел должен быть больше нуля");

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.проверка.Поставщик", "файлы");
	Настройки.Вставить("cache.проверка.Предел", 1000);
	ПроверитьОшибкуСборки("ЖелудьСКэшемПроверки", Настройки, "обязательна настройка cache.проверка.Каталог");

КонецПроцедуры

&Тест
Процедура КэшируемаяПроцедураОтвергаетсяПриСборкеЖелудя() Экспорт
	ПроверитьОшибкуСборки("ЖелудьСКэшируемойПроцедурой", Новый Соответствие, "только экспортную функцию");
КонецПроцедуры

&Тест
Процедура ИмяКэшаСТочкойОтвергается() Экспорт

	Менеджер = НоваяПоделка().НайтиЖелудь("МенеджерКэшей");

	Попытка
		Менеджер.Кэш("с.точкой");
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("без точек");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение для имени с точкой";

КонецПроцедуры

Функция НоваяПоделка(Знач Настройки = Неопределено)

	Если Настройки = Неопределено Тогда
		Настройки = Новый Соответствие;
		Настройки.Вставить("cache.малый.Предел", 2);
		Настройки.Вставить("cache.артефакты.Поставщик", "файлы");
		Настройки.Вставить("cache.артефакты.Предел", 1000);
		Настройки.Вставить("cache.артефакты.Каталог", Каталог);
	КонецЕсли;

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Настройки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

Процедура ПроверитьОшибкуНастроек(Параметр, Значение, ОжидаемыйТекст)

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.проверка." + Параметр, Значение);
	ПроверитьОшибкуСборки("ЖелудьСКэшемПроверки", Настройки, ОжидаемыйТекст);

КонецПроцедуры

// ОСень не выпускает исключение сборки желудя наружу: пишет его в журнал и отдаёт Неопределено.
// Поэтому текст ошибки проверяется вызовом напильника напрямую.
Процедура ПроверитьОшибкуСборки(ИмяЖелудя, Настройки, ОжидаемыйТекст)

	Поделка = НоваяПоделка(Настройки);
	Ожидаем.Что(Поделка.НайтиЖелудь(ИмяЖелудя)).Равно(Неопределено);

	Напильник = Поделка.НайтиЖелудь("НапильникКэша");
	Определение = Поделка.ПолучитьОпределениеЖелудя(ИмяЖелудя);

	Попытка
		Напильник.ОбработатьЖелудь(Новый(Определение.ТипЖелудя()), Определение);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
		Возврат;
	КонецПопытки;

	ВызватьИсключение СтрШаблон("Ожидалась ошибка сборки желудя %1: %2", ИмяЖелудя, ОжидаемыйТекст);

КонецПроцедуры
