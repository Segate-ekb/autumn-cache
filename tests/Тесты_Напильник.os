КонецПроцедуры

&Тест
Процедура НастройкиКэшаЧитаютсяПоИмени() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");

	Для Номер = 1 По 3 Цикл
		Сервис.Малое(Номер);
	КонецЦикла;
	Сервис.Малое(1);
	Ожидаем.Что(Сервис.Вызовов("Малое")).Равно(4);

