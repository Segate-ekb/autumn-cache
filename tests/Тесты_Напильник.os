	Ожидаем.Что(Второй).Равно(Первый);
	Ожидаем.Что(Сервис.Вызовов("Профиль")).Равно(1);
	Ожидаем.Что(Сервис.Вызовов("ИзменяемыйПрофиль")).Равно(2);

