#Использовать ".."
#Использовать "fixtures"
#Использовать autumn
#Использовать asserts

// Аннотации кэша на живой поделке: ключ, сброс, настройки по имени, соседний напильник.

Перем Каталог;

&ПередКаждым
Процедура СоздатьИмяКаталога() Экспорт
	Каталог = ПолучитьИмяВременногоФайла("autumn-cache");
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьКаталог() Экспорт
	УдалитьФайлы(Каталог);
КонецПроцедуры

&Тест
Процедура ПовторныйВызовСТемЖеКлючомНеВызываетМетод() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");

	Первый = Сервис.Настройка("раздел", "имя", "первый контекст");
	Второй = Сервис.Настройка("раздел", "имя", "второй контекст");
	Сервис.Настройка("раздел", "другое имя", "первый контекст");

	Ожидаем.Что(Второй).Равно(Первый);
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(2);

КонецПроцедуры

&Тест
Процедура ИсключениеИНеопределеноНеКэшируются() Экспорт

	Сервис = НоваяПоделка().НайтиЖелудь("СервисСКэшем");

	Для Номер = 1 По 2 Цикл
		Попытка
			Сервис.Сбойное("ключ");
		Исключение
			Ожидаем.Что(ОписаниеОшибки()).Содержит("Сбой исходного метода");
		КонецПопытки;
		Ожидаем.Что(Сервис.Пустое("ключ")).Равно(Неопределено);
	КонецЦикла;

	Ожидаем.Что(Сервис.Вызовов("Сбойное")).Равно(2);
	Ожидаем.Что(Сервис.Вызовов("Пустое")).Равно(2);

КонецПроцедуры

&Тест
Процедура СоседВидитПередИПослеНаПромахеИПопадании() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");
	Журнал = Поделка.НайтиЖелудь("НапильникСвидетель").Журнал;

	Сервис.Настройка("раздел", "имя", "");
	Сервис.Настройка("раздел", "имя", "");

	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(1);
	Ожидаем.Что(СтрСоединить(Журнал, ",")).Равно("Перед,После,Перед,После");

КонецПроцедуры

&Тест
Процедура ОбъектВКлючеПроходитЧерезПослеВызоваИсключенияСоседа() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");
	Журнал = Поделка.НайтиЖелудь("НапильникСвидетель").Журнал;

	Попытка
		Сервис.ПоОбъекту(Новый Структура);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не может быть частью ключа кэша");
	КонецПопытки;

	Ожидаем.Что(Сервис.Вызовов("ПоОбъекту")).Равно(0);
	Ожидаем.Что(СтрСоединить(Журнал, ",")).Равно("Перед,ПослеВызоваИсключения");

КонецПроцедуры

&Тест
Процедура СбросПоКлючуИВсехЗаписей() Экспорт

	Поделка = НоваяПоделка();
	Сервис = Поделка.НайтиЖелудь("СервисСКэшем");
	Сервис.Настройка("раздел", "а", "");
	Сервис.Настройка("раздел", "б", "");

	Сервис.ЗабытьНастройку("раздел", "а", "причина");
	Сервис.Настройка("раздел", "а", "");
	Сервис.Настройка("раздел", "б", "");
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(3);

	Поделка.НайтиЖелудь("МенеджерКэшей").Кэш("настройки").Удалить(Новый КлючКэша().Добавить("раздел").Добавить("б"));
	Сервис.Настройка("раздел", "б", "");
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(4);

	Сервис.ЗабытьВсеНастройки();
	Сервис.Настройка("раздел", "а", "");
	Сервис.Настройка("раздел", "б", "");
	Ожидаем.Что(Сервис.Вызовов("Настройка")).Равно(6);

КонецПроцедуры

