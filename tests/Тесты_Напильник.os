&Тест
Процедура МетодСФиксированнымРезультатомКэшируетсяВОбщемБюджете() Экспорт

	Настройки = Новый Соответствие;
	Настройки.Вставить("cache.ПределПамяти", 100000);
	Сервис = НоваяПоделка(Настройки).НайтиЖелудь("СервисСКэшем");

	Первый = Сервис.Профиль(1);
	Второй = Сервис.Профиль(1);
	Сервис.ИзменяемыйПрофиль(1);
