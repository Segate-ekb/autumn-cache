	Кэш.Положить("большая", ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(8075)));
	Ожидаем.Что(Кэш.Получить("большая")).Равно(Неопределено);

