#Использовать ".."
#Использовать "../src/internal"
#Использовать "fixtures"
#Использовать asserts

// Кэш в файлах: хранит ДвоичныеДанные и потоки, забирает готовые файлы, предел в байтах, файлы
// вытесненных записей удаляются, а неудалённые убираются повторно.

Перем Каталог;
Перем КаталогВызывающего;

&ПередКаждым
Процедура СоздатьИменаКаталогов() Экспорт
	Каталог = ПолучитьИмяВременногоФайла("autumn-cache");
	КаталогВызывающего = ПолучитьИмяВременногоФайла("autumn-cache-вызывающий");
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьКаталоги() Экспорт
	Если Новый Файл(Каталог).Существует() Тогда
		КаталогТолькоДляЧтения(Ложь);
	КонецЕсли;
	УдалитьФайлы(Каталог);
	УдалитьФайлы(КаталогВызывающего);
КонецПроцедуры

&Тест
Процедура ДвоичныеДанныеКладутсяИЧитаются() Экспорт

	Кэш = КэшВФайлах(1000);
	Кэш.Положить("документ", ДанныеРазмером(100, 7));

	Прочитанное = Кэш.Получить("документ");

	Ожидаем.Что(Прочитанное.Размер()).Равно(100);
	Ожидаем.Что(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Прочитанное)[0]).Равно(7);
	Ожидаем.Что(НайтиФайлы(Каталог, "*.cache").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура НеДвоичныеДанныеВызываютИсключение() Экспорт

	Кэш = КэшВФайлах(1000);

	Попытка
		Кэш.Положить("строка", "текст");
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(СтрШаблон(
			"файловый кэш хранит только ДвоичныеДанные, получено значение типа %1", Тип("Строка")));
		Ожидаем.Что(НайтиФайлы(Каталог, "*").Количество()).Равно(0);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение для строки";

КонецПроцедуры

&Тест
Процедура ТяжёлаяЗаписьВытесняетЛёгкиеРовноДоПредела() Экспорт

	Кэш = КэшВФайлах(1000);
	Для Номер = 1 По 20 Цикл
		Кэш.Положить(Номер, ДанныеРазмером(50));
	КонецЦикла;

	Кэш.Положить("тяжёлая", ДанныеРазмером(100));

	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(2);
	Ожидаем.Что(Кэш.Получить(1)).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить(2)).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить(3)).Не_().Равно(Неопределено);
	Ожидаем.Что(РазмерКаталога()).Равно(1000);

КонецПроцедуры

&Тест
Процедура ЗначениеТяжелееДолиПределаНеКладётся() Экспорт

	Кэш = КэшВФайлах(1000);
	Кэш.Положить("большой", ДанныеРазмером(101));

	Ожидаем.Что(Кэш.Получить("большой")).Равно(Неопределено);
	Ожидаем.Что(НайтиФайлы(Каталог, "*.cache").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТяжёлоеЗначениеУбираетПрежнююЗапись() Экспорт

	Кэш = КэшВФайлах(1000);
	Кэш.Положить("документ", ДанныеРазмером(50));

	Кэш.Положить("документ", ДанныеРазмером(101));

	Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);
	Ожидаем.Что(НайтиФайлы(Каталог, "*.cache").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ПотокКладётсяИОтдаётсяПотокомНадФайломЗаписи() Экспорт

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(100);
	Источник = Исходные.ОткрытьПотокДляЧтения();

	Выдача = Кэш.Положить("документ", Источник);

	Ожидаем.Что(Источник.ДоступноЧтение).ЭтоЛожь();
	Ожидаем.Что(ТипЗнч(Выдача)).Равно(Тип("ФайловыйПоток"));
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Выдача)).Равно(Исходные);

	// Два попадания читают один файл записи одновременно.
	Первое = Кэш.Получить("документ");
	Второе = Кэш.Получить("документ");
	Ожидаем.Что(ТипЗнч(Первое)).Равно(Тип("ФайловыйПоток"));
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Первое)).Равно(Исходные);
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Второе)).Равно(Исходные);
	Ожидаем.Что(Кэш.Статистика().Занято).Равно(100);
	Ожидаем.Что(РазмерКаталога()).Равно(100);

КонецПроцедуры

&Тест
Процедура ПотокиВсехВидовКладутсяОтТекущейПозиции() Экспорт

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(100);
	ПутьИсточника = ОбъединитьПути(Каталог, "источник.bin");
	Исходные.Записать(ПутьИсточника);
	ВПамяти = Новый ПотокВПамяти();
	Исходные.ОткрытьПотокДляЧтения().КопироватьВ(ВПамяти);

	Источники = Новый Массив;
	Источники.Добавить(Исходные.ОткрытьПотокДляЧтения());
	Источники.Добавить(ВПамяти);
	Источники.Добавить(ФайловыеПотоки.ОткрытьДляЧтения(ПутьИсточника));

	Для Каждого Источник Из Источники Цикл
		Источник.Перейти(30, ПозицияВПотоке.Начало);
		Кэш.Положить(Строка(ТипЗнч(Источник)), Источник).Закрыть();
	КонецЦикла;

	Хвост = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
		ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Исходные).Прочитать(30, 70));
	Для Каждого Источник Из Источники Цикл
		Ожидаем.Что(ТестовыеБайты.ИзПотока(Кэш.Получить(Строка(ТипЗнч(Источник))))).Равно(Хвост);
	КонецЦикла;
	Ожидаем.Что(Кэш.Статистика().Занято).Равно(210);
	Ожидаем.Что(РазмерКаталога()).Равно(210);

КонецПроцедуры

&Тест
Процедура ЗначениеИПотокВОдномКэшеОтдаютсяКакПоложены() Экспорт

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(50);

	Кэш.Положить("данные", Исходные);
	Кэш.Положить("поток", Исходные.ОткрытьПотокДляЧтения()).Закрыть();

	Ожидаем.Что(ТипЗнч(Кэш.Получить("данные"))).Равно(Тип("ДвоичныеДанные"));
	Ожидаем.Что(Кэш.Получить("данные")).Равно(Исходные);
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Кэш.Получить("поток"))).Равно(Исходные);

КонецПроцедуры

&Тест
Процедура ПотокТяжелееДолиПределаОстаётсяУВызывающегоНетронутым() Экспорт

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(101);
	Источник = Исходные.ОткрытьПотокДляЧтения();

	Выдача = Кэш.Положить("большой", Источник);

	Ожидаем.Что(Выдача = Источник).ЭтоИстина();
	Ожидаем.Что(Источник.ТекущаяПозиция()).Равно(0);
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Источник)).Равно(Исходные);
	Ожидаем.Что(Кэш.Получить("большой")).Равно(Неопределено);
	Ожидаем.Что(ФайловКэша()).Равно(0);

КонецПроцедуры

&Тест
Процедура СбросВоВремяВызоваОставляетПотокВызывающему() Экспорт

	Кэш = КэшВФайлах(1000);
	Источник = ТестовыеБайты.СУзором(50).ОткрытьПотокДляЧтения();
	ПоколениеВызова = Кэш.Поколение();
	Кэш.Удалить("документ");

	Выдача = Кэш.Запомнить(Новый КлючКэша().Добавить("документ"), Источник, ПоколениеВызова);

	Ожидаем.Что(Выдача = Источник).ЭтоИстина();
	Ожидаем.Что(Источник.ДоступноЧтение).ЭтоИстина();
	Ожидаем.Что(ФайловКэша()).Равно(0);

КонецПроцедуры

&Тест
Процедура ПотокиВытесняютсяПоВесуФайлов() Экспорт

	Кэш = КэшВФайлах(1000);
	Для Номер = 1 По 20 Цикл
		Кэш.Положить(Номер, ТестовыеБайты.СУзором(50, Номер).ОткрытьПотокДляЧтения()).Закрыть();
	КонецЦикла;

	Кэш.Положить("тяжёлый", ТестовыеБайты.СУзором(100).ОткрытьПотокДляЧтения()).Закрыть();

	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(2);
	Ожидаем.Что(Кэш.Получить(1)).Равно(Неопределено);
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Кэш.Получить(3))).Равно(ТестовыеБайты.СУзором(50, 3));
	Ожидаем.Что(Кэш.Статистика().Занято).Равно(1000);
	Ожидаем.Что(РазмерКаталога()).Равно(1000);

КонецПроцедуры

&Тест
Процедура ПотокНадЗаписьюДочитываетсяПослеУбораЗаписи() Экспорт

	Для Каждого Уборка Из СтрРазделить("Удалить,Очистить,Вытеснить", ",") Цикл

		// Запись занимает весь предел: следующая вытесняет её.
		Кэш = Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Новый БюджетКэша(100, 100), 0);
		Исходные = ТестовыеБайты.СУзором(100);
		Кэш.Положить("документ", Исходные.ОткрытьПотокДляЧтения()).Закрыть();
		Читатель = Кэш.Получить("документ");

		Если Уборка = "Удалить" Тогда
			Кэш.Удалить("документ");
		ИначеЕсли Уборка = "Очистить" Тогда
			Кэш.Очистить();
		Иначе
			Кэш.Положить("другой", ТестовыеБайты.СУзором(100, 1));
		КонецЕсли;

		Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);
		Если НЕ ЭтоWindows() Тогда
			Ожидаем.Что(ФайлЗаписиЕсть(Исходные)).ЭтоЛожь();
		КонецЕсли;
		Ожидаем.Что(ТестовыеБайты.ИзПотока(Читатель)).Равно(Исходные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеудалённыйФайлЗаписиУбираетсяПовторнойУборкой() Экспорт

	Если НЕ ЭтоWindows() И НЕ ПраваКаталогаДержат() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Уборка Из СтрРазделить("Удалить,Очистить", ",") Цикл

		Кэш = КэшВФайлах(1000);
		Кэш.Положить("документ", ТестовыеБайты.СУзором(50).ОткрытьПотокДляЧтения()).Закрыть();
		Читатель = Кэш.Получить("документ");
		КаталогТолькоДляЧтения(Истина);

		Кэш.Удалить("документ");

		Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);
		Ожидаем.Что(Кэш.Статистика().Занято).Равно(0);
		Ожидаем.Что(ФайловКэша()).Равно(1);

		Читатель.Закрыть();
		КаталогТолькоДляЧтения(Ложь);
		Кэш.Положить("другой", ТестовыеБайты.СУзором(50, 1));
		Если Уборка = "Удалить" Тогда
			Кэш.Удалить("другой");
		Иначе
			Кэш.Очистить();
		КонецЕсли;

		Ожидаем.Что(ФайловКэша()).Равно(0);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ФайлПрошлогоЗапускаНеУдалённыйПриСозданииУбираетсяПозже() Экспорт

	Если НЕ ЭтоWindows() И НЕ ПраваКаталогаДержат() Тогда
		Возврат;
	КонецЕсли;

	СоздатьКаталог(Каталог);
	СтарыйФайл = ОбъединитьПути(Каталог, "старая-запись.cache");
	ДанныеРазмером(10).Записать(СтарыйФайл);
	Читатель = ФайловыеПотоки.ОткрытьДляЧтения(СтарыйФайл);
	КаталогТолькоДляЧтения(Истина);

	Кэш = КэшВФайлах(1000);

	Ожидаем.Что(Новый Файл(СтарыйФайл).Существует()).ЭтоИстина();

	Читатель.Закрыть();
	КаталогТолькоДляЧтения(Ложь);
	Кэш.Положить("документ", ДанныеРазмером(10));
	Кэш.Удалить("документ");

	Ожидаем.Что(ФайловКэша()).Равно(0);

КонецПроцедуры

&Тест
Процедура ИстёкшаяПотоковаяЗаписьПромахИФайлУбран() Экспорт

	Кэш = Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Новый БюджетКэша(1000, 100), 0.05);
	Кэш.Положить("документ", ТестовыеБайты.СУзором(50).ОткрытьПотокДляЧтения()).Закрыть();

	Приостановить(200);

	Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(1);
	Ожидаем.Что(ФайловКэша()).Равно(0);

КонецПроцедуры

&Тест
Процедура ПустойПотокКладётсяИОтдаётсяПустым() Экспорт

	Кэш = КэшВФайлах(1000);
	Пустые = ПолучитьДвоичныеДанныеИзСтроки("");

	Ожидаем.Что(ТестовыеБайты.ИзПотока(Кэш.Положить("пусто", Пустые.ОткрытьПотокДляЧтения()))).Равно(Пустые);
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Кэш.Получить("пусто"))).Равно(Пустые);
	Ожидаем.Что(Кэш.Статистика().Занято).Равно(0);
	Ожидаем.Что(ФайловКэша()).Равно(1);

КонецПроцедуры

&Тест
Процедура СорвавшеесяКопированиеНеОставляетЗаписиИВозвращаетПоток() Экспорт

	Бюджет = Новый БюджетКэша(1000, 100);
	Кэш = Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Бюджет, 0);
	// Поток только на запись: размер известен, а читать его нельзя.
	Источник = Новый ФайловыйПоток(ФайлВызывающего(ТестовыеБайты.СУзором(100)),
		РежимОткрытияФайла.Открыть, ДоступКФайлу.Запись);
	Источник.Перейти(30, ПозицияВПотоке.Начало);

	ОжидатьОтказПоложить(Кэш, "документ", Источник, "");
	Выдача = Кэш.Запомнить(Новый КлючКэша().Добавить("документ"), Источник, Кэш.Поколение());

	Ожидаем.Что(Выдача = Источник).ЭтоИстина();
	Ожидаем.Что(Источник.ТекущаяПозиция()).Равно(30);
	Ожидаем.Что(Бюджет.Занято()).Равно(0);
	Ожидаем.Что(ФайловКэша()).Равно(0);
	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура НеоткрывшийсяПотокНадЗаписьюОтменяетЗапись() Экспорт

	Для Каждого Сбой Из СтрРазделить("Неопределено,исключение", ",") Цикл

		Бюджет = Новый БюджетКэша(1000, 100);
		Поставщик = Новый ПоставщикСНеоткрывающимсяПотоком(Новый ФайлыКэша(Каталог), Сбой);
		Кэш = Новый Кэш("файлы", Поставщик, Бюджет, 0);
		Исходные = ТестовыеБайты.СУзором(100);
		Источник = Исходные.ОткрытьПотокДляЧтения();
		Источник.Перейти(30, ПозицияВПотоке.Начало);

		ОжидатьОтказПоложить(Кэш, "документ", Источник,
			?(Сбой = "исключение", "Сбой открытия потока над записью", "поток над записью не открылся"));
		Выдача = Кэш.Запомнить(Новый КлючКэша().Добавить("документ"), Источник, Кэш.Поколение());

		Ожидаем.Что(Выдача = Источник).ЭтоИстина();
		Ожидаем.Что(Источник.ТекущаяПозиция()).Равно(30);
		Ожидаем.Что(Бюджет.Занято()).Равно(0);
		Ожидаем.Что(ФайловКэша()).Равно(0);
		Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ФайлЗабираетсяПеремещениемИОтдаётсяПотокомНадЗаписью() Экспорт

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(100);
	Путь = ФайлВызывающего(Исходные);

	Ожидаем.Что(Кэш.ПоложитьФайл("документ", Путь)).ЭтоИстина();

	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоЛожь();
	Для Номер = 1 По 2 Цикл
		Попадание = Кэш.Получить("документ");
		Ожидаем.Что(ТипЗнч(Попадание)).Равно(Тип("ФайловыйПоток"));
		Ожидаем.Что(ТестовыеБайты.ИзПотока(Попадание)).Равно(Исходные);
	КонецЦикла;
	Ожидаем.Что(Кэш.Статистика().Занято).Равно(100);
	Ожидаем.Что(РазмерКаталога()).Равно(100);

КонецПроцедуры

&Тест
Процедура ФайлТяжелееДолиПределаОстаётсяУВызывающегоНетронутым() Экспорт

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(101);
	Путь = ФайлВызывающего(Исходные);

	Ожидаем.Что(Кэш.ПоложитьФайл("большой", Путь)).ЭтоЛожь();

	Ожидаем.Что(Новый ДвоичныеДанные(Путь)).Равно(Исходные);
	Ожидаем.Что(Кэш.Получить("большой")).Равно(Неопределено);
	Ожидаем.Что(ФайловКэша()).Равно(0);

КонецПроцедуры

&Тест
Процедура НесуществующийФайлНеКладётся() Экспорт

	Кэш = КэшВФайлах(1000);

	Ожидаем.Что(Кэш.ПоложитьФайл("документ", ОбъединитьПути(КаталогВызывающего, "нет.bin"))).ЭтоЛожь();

	Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);
	Ожидаем.Что(ФайловКэша()).Равно(0);

КонецПроцедуры

&Тест
Процедура СорвавшийсяПереносФайлаОставляетЕгоУВызывающего() Экспорт

	Если НЕ ПраваКаталогаДержат() Тогда
		Возврат;
	КонецЕсли;

	Бюджет = Новый БюджетКэша(1000, 100);
	Кэш = Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Бюджет, 0);
	Исходные = ТестовыеБайты.СУзором(100);
	Путь = ФайлВызывающего(Исходные);

	КаталогТолькоДляЧтения(Истина);
	Попытка
		Кэш.ПоложитьФайл("документ", Путь);
		Сорвался = Ложь;
	Исключение
		Сорвался = Истина;
	КонецПопытки;
	КаталогТолькоДляЧтения(Ложь);

	Ожидаем.Что(Сорвался).ЭтоИстина();
	Ожидаем.Что(Новый ДвоичныеДанные(Путь)).Равно(Исходные);
	Ожидаем.Что(ФайловКэша()).Равно(0);
	Ожидаем.Что(Бюджет.Занято()).Равно(0);
	Ожидаем.Что(Кэш.ПоложитьФайл("документ", Путь)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВытеснениеЗабранногоФайлаУдаляетЕго() Экспорт

	// Запись занимает весь предел: следующая вытесняет её.
	Кэш = Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Новый БюджетКэша(100, 100), 0);
	Исходные = ТестовыеБайты.СУзором(100);
	Кэш.ПоложитьФайл("документ", ФайлВызывающего(Исходные));

	Кэш.Положить("другой", ТестовыеБайты.СУзором(100, 1));

	Ожидаем.Что(Кэш.Получить("документ")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(1);
	Ожидаем.Что(ФайлЗаписиЕсть(Исходные)).ЭтоЛожь();
	Ожидаем.Что(ФайловКэша()).Равно(1);

КонецПроцедуры

&Тест
Процедура ЧитательФайлаДочитываетЕгоПослеПереносаВКэш() Экспорт

	// На Windows файл, открытый на чтение, не переносится: ПоложитьФайл вызывает исключение.
	Если ЭтоWindows() Тогда
		Возврат;
	КонецЕсли;

	Кэш = КэшВФайлах(1000);
	Исходные = ТестовыеБайты.СУзором(100);
	Путь = ФайлВызывающего(Исходные);
	Читатель = ФайловыеПотоки.ОткрытьДляЧтения(Путь);

	Ожидаем.Что(Кэш.ПоложитьФайл("документ", Путь)).ЭтоИстина();

	Ожидаем.Что(ТестовыеБайты.ИзПотока(Читатель)).Равно(Исходные);
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Кэш.Получить("документ"))).Равно(Исходные);

КонецПроцедуры

&Тест
Процедура ПараллельныеОперацииДержатПределИЗначенияКлючей() Экспорт

	Кэш = КэшВФайлах(2000);
	Задания = Новый Массив;
	Для НомерЗадания = 1 По 4 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Кэш);
		Параметры.Добавить(НомерЗадания);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "НагрузитьКэш", Параметры));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.ОжидатьЗавершения(10000)).ЭтоИстина();
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		Ожидаем.Что(Задание.Результат).Равно(0);
	КонецЦикла;

	// На Windows файл, открытый читателем, не удаляется и остаётся вне учёта до следующей уборки.
	Если НЕ ЭтоWindows() Тогда
		Ожидаем.Что(РазмерКаталога()).Не_().Больше(2000);
	КонецЕсли;

КонецПроцедуры

// Смешанные операции над файловым кэшем; первый байт значения — номер его ключа.
//
// Параметры:
//   Кэш          - Кэш - Файловый кэш
//   НомерЗадания - Число - Зерно генератора операций
//
// Возвращаемое значение:
//   Число - Сколько раз Получить отдал значение чужого ключа
//
Функция НагрузитьКэш(Кэш, НомерЗадания) Экспорт

	Нарушений = 0;
	Генератор = Новый ГенераторСлучайныхЧисел(НомерЗадания);

	Для Шаг = 1 По 1000 Цикл
		НомерКлюча = Генератор.СлучайноеЧисло(0, 29);
		Операция = Генератор.СлучайноеЧисло(0, 99);
		Если Операция < 50 Тогда
			Кэш.Положить(НомерКлюча, ДанныеРазмером(Генератор.СлучайноеЧисло(1, 200), НомерКлюча));
		ИначеЕсли Операция < 85 Тогда
			Значение = Кэш.Получить(НомерКлюча);
			Если Значение <> Неопределено
				И ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Значение)[0] <> НомерКлюча Тогда
				Нарушений = Нарушений + 1;
			КонецЕсли;
		ИначеЕсли Операция < 97 Тогда
			Кэш.Удалить(НомерКлюча);
		Иначе
			Кэш.Очистить();
		КонецЕсли;
	КонецЦикла;

	Возврат Нарушений;

КонецФункции

&Тест
Процедура ПриСозданииУдаляютсяТолькоФайлыКэша() Экспорт

	СоздатьКаталог(Каталог);
	ДанныеРазмером(10).Записать(ОбъединитьПути(Каталог, "старая-запись.cache"));
	ДанныеРазмером(10).Записать(ОбъединитьПути(Каталог, "чужой.bin"));

	КэшВФайлах(1000);

	Ожидаем.Что(НайтиФайлы(Каталог, "*.cache").Количество()).Равно(0);
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Каталог, "чужой.bin")).Существует()).ЭтоИстина();

КонецПроцедуры

Функция КэшВФайлах(Предел)
	Возврат Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Новый БюджетКэша(Предел, Предел * 0.1), 0);
КонецФункции

// Файл вызывающего лежит вне каталога кэша, на том же томе.
Функция ФайлВызывающего(Данные)

	СоздатьКаталог(КаталогВызывающего);
	Путь = ОбъединитьПути(КаталогВызывающего, Строка(Новый УникальныйИдентификатор) + ".bin");
	Данные.Записать(Путь);

	Возврат Путь;

КонецФункции

Функция ФайлЗаписиЕсть(Данные)

	Для Каждого Файл Из НайтиФайлы(Каталог, "*.cache") Цикл
		Если Новый ДвоичныеДанные(Файл.ПолноеИмя) = Данные Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ФайловКэша()
	Возврат НайтиФайлы(Каталог, "*.cache").Количество();
КонецФункции

// Неудаление файла тесты моделируют открытым читателем (держит файл на Windows) и каталогом кэша
// только для чтения (не даёт создавать и удалять файлы на macOS и Linux, если процесс не root).
Процедура КаталогТолькоДляЧтения(Признак)
	Файл = Новый Файл(Каталог);
	Файл.УстановитьТолькоЧтение(Признак);
КонецПроцедуры

// Проверка на пробном файле: под root и на Windows права каталога не держат удаление.
Функция ПраваКаталогаДержат()

	СоздатьКаталог(Каталог);
	Проба = ОбъединитьПути(Каталог, "проба.bin");
	ДанныеРазмером(1).Записать(Проба);
	КаталогТолькоДляЧтения(Истина);
	Попытка
		УдалитьФайлы(Проба);
	Исключение
		// Удаление не пустили — модель работает.
	КонецПопытки;
	КаталогТолькоДляЧтения(Ложь);

	Держат = Новый Файл(Проба).Существует();
	УдалитьФайлы(Проба);

	Возврат Держат;

КонецФункции

// Отказ Положить с текстом; пустой ожидаемый текст — любой отказ.
Процедура ОжидатьОтказПоложить(Кэш, Ключ, Значение, ОжидаемыйТекст)

	Попытка
		Кэш.Положить(Ключ, Значение);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидался отказ Положить";

КонецПроцедуры

Функция ЭтоWindows()
	Платформа = Новый СистемнаяИнформация().ТипПлатформы;
	Возврат Платформа = ТипПлатформы.Windows_x86 ИЛИ Платформа = ТипПлатформы.Windows_x86_64;
КонецФункции

Функция ДанныеРазмером(Размер, ПервыйБайт = 0)

	Буфер = Новый БуферДвоичныхДанных(Размер);
	Буфер.Установить(0, ПервыйБайт);

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

Функция РазмерКаталога()

	Размер = 0;
	Для Каждого Файл Из НайтиФайлы(Каталог, "*.cache") Цикл
		Размер = Размер + Файл.Размер();
	КонецЦикла;

	Возврат Размер;

КонецФункции
