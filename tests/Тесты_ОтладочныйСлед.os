#Использовать ".."
#Использовать "../src/internal"
#Использовать "fixtures"
#Использовать asserts
#Использовать logos

// Отладочный след кэша: на уровне Отладка виден каждый шаг, на уровне Информация — ничего.

Перем Лог;
Перем Журнал;
Перем ПрежнийУровень;

&ПередКаждым
Процедура ПодключитьЖурнал() Экспорт
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");
	ПрежнийУровень = Лог.Уровень();
	Журнал = Новый ЖурналВПамяти();
	Лог.ДобавитьСпособВывода(Журнал);
КонецПроцедуры

&ПослеКаждого
Процедура ОтключитьЖурнал() Экспорт
	Лог.УдалитьСпособВывода(Журнал);
	Лог.ДобавитьСпособВывода(Новый ВыводЛогаВКонсоль());
	Лог.УстановитьУровень(ПрежнийУровень);
КонецПроцедуры

&Тест
Процедура НаУровнеОтладкаВиденПутьЗначения() Экспорт

	Лог.УстановитьУровень(УровниЛога.Отладка);
	Кэш = Новый Кэш("след", Новый ПамятьКэша(), 1, 1, 0);

	Кэш.Получить("а");
	Кэш.Положить("а", 1);
	Кэш.Получить("а");
	Кэш.Положить("б", 2);
	Кэш.Положить("в", Неопределено);
	Кэш.Удалить("б");

	Ожидаем.Что(Журнал.Сообщения).Содержит("Кэш ""след"": промах, ключ С1:а");
	Ожидаем.Что(Журнал.Сообщения).Содержит("Кэш ""след"": положено, ключ С1:а, вес 1, занято 1 из 1");
	Ожидаем.Что(Журнал.Сообщения).Содержит("Кэш ""след"": попадание, ключ С1:а, вес 1, сегмент испытательный");
	Ожидаем.Что(Журнал.Сообщения).Содержит("Кэш ""след"": вытеснение, ключ С1:а, вес 1, сегмент испытательный");
	Ожидаем.Что(Журнал.Сообщения).Содержит("Кэш ""след"": не положено, ключ С1:в: значение Неопределено");
	Ожидаем.Что(Журнал.Сообщения).Содержит("Кэш ""след"": сброс ключа С1:б, удалено записей 1, новое поколение 1");

КонецПроцедуры

&Тест
Процедура НаУровнеИнформацияОтладочныхСтрокНет() Экспорт

	Лог.УстановитьУровень(УровниЛога.Информация);
	Кэш = Новый Кэш("след", Новый ПамятьКэша(), 1, 1, 0);

	Кэш.Получить("а");
	Кэш.Положить("а", 1);
	Кэш.Получить("а");
	Кэш.Положить("б", 2);

	Ожидаем.Что(Журнал.Сообщения.Количество()).Равно(0);

КонецПроцедуры
