#Использовать ".."
#Использовать "../src/internal"
#Использовать "fixtures"
#Использовать asserts
#Использовать logos

// Отладочный след кэша: на уровне Отладка виден каждый шаг с числами, на уровне Информация — ничего.

Перем Лог;
Перем Журнал;
Перем ПрежнийУровень;
Перем БылиСобственныеВыводы;
Перем Каталог;

&ПередКаждым
Процедура ПодключитьЖурнал() Экспорт
	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");
	ПрежнийУровень = Лог.Уровень();
	БылиСобственныеВыводы = Лог.ДобавленыСобственныеСпособыВывода();
	Журнал = Новый ЖурналВПамяти();
	Лог.ДобавитьСпособВывода(Журнал);
	Каталог = ПолучитьИмяВременногоФайла("autumn-cache");
КонецПроцедуры

&ПослеКаждого
Процедура ОтключитьЖурнал() Экспорт
	Лог.УдалитьСпособВывода(Журнал);
	Если НЕ БылиСобственныеВыводы Тогда
		Лог.ДобавитьСпособВывода(Новый ВыводЛогаВКонсоль());
	КонецЕсли;
	Лог.УстановитьУровень(ПрежнийУровень);
	УдалитьФайлы(Каталог);
КонецПроцедуры

&Тест
Процедура ПутьЧтенияИЗаписиВиденСЧислами() Экспорт

	Лог.УстановитьУровень(УровниЛога.Отладка);
	Кэш = Новый Кэш("след", Новый ПамятьКэша(), Новый БюджетКэша(1, 1), 0);

	Кэш.Получить("а");
	Кэш.Положить("а", 1);
	Кэш.Получить("а");
	Кэш.Положить("б", 2);
	Кэш.Положить("в", Неопределено);
	Кэш.Положить("г", NULL);
	Кэш.Удалить("б");
	Кэш.Положить("д", 3);
	Кэш.Очистить();

	ОжидатьСтроку("Кэш ""след"": промах, ключ С1:а");
	ОжидатьСтроку("Кэш ""след"": положено, ключ С1:а, вес 1, занято бюджета 1 из 1");
	ОжидатьСтроку("Кэш ""след"": попадание, ключ С1:а, вес 1, сегмент испытательный");
	ОжидатьСтроку("Кэш ""след"": вытеснение, ключ С1:а, вес 1, сегмент испытательный, давление 2 из 1");
	ОжидатьСтроку("Кэш ""след"": не положено, ключ С1:в, значение Неопределено");
	ОжидатьСтроку("Кэш ""след"": не положено, ключ С1:г, значение NULL");
	ОжидатьСтроку("Кэш ""след"": сброс, ключ С1:б, удалено записей 1, поколение 1");
	ОжидатьСтроку("Кэш ""след"": очистка, удалено записей 1, поколение 2");

КонецПроцедуры

&Тест
Процедура ОтказыПоложитьВидныСПричиной() Экспорт

	Лог.УстановитьУровень(УровниЛога.Отладка);
	Кэш = Новый Кэш("байты", Новый ПамятьКэша(Истина), Новый БюджетКэша(1000, 100), 0);

	Кэш.Положить("строка", "0123456789012345678901234567890123456789");
	Кэш.Запомнить(Новый КлючКэша().Добавить("структура"), Новый Структура, Кэш.Поколение());
	ПоколениеВызова = Кэш.Поколение();
	Кэш.Удалить("число");
	Кэш.Запомнить(Новый КлючКэша().Добавить("число"), 1, ПоколениеВызова);

	ОжидатьСтроку("Кэш ""байты"": не положено, ключ С6:строка, вес 1960 больше допустимого 100 при пределе 1000");
	ОжидатьСтроку(СтрШаблон("Кэш ""байты"": не положено, ключ С9:структура, значение типа %1 изменяемое, "
			+ "кэш в памяти с пределом в байтах хранит фиксированные коллекции", Тип("Структура")));
	ОжидатьСтроку("Кэш ""байты"": не положено, ключ С5:число, кэш сброшен во время вызова, поколение 0, текущее 1");

КонецПроцедуры

&Тест
Процедура СбросВоВремяЗаписиВиденВЖурнале() Экспорт

	Лог.УстановитьУровень(УровниЛога.Отладка);
	Затвор = Новый Структура("Открыт, ЗаписьНачалась", Ложь, Ложь);
	Кэш = Новый Кэш("затвор", Новый ПоставщикСЗатвором(Затвор), Новый БюджетКэша(10, 10), 0);

	Параметры = Новый Массив;
	Параметры.Добавить(Кэш);
	Параметры.Добавить(Новый Структура("Вес, ЖдатьЗатвора", 4, Истина));
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВ", Параметры);
	Ожидаем.Что(Дождаться(Затвор)).ЭтоИстина();
	Кэш.Удалить("в");
	Затвор.Открыт = Истина;
	Ожидаем.Что(Задание.ОжидатьЗавершения(5000)).ЭтоИстина();

	ОжидатьСтроку("Кэш ""затвор"": не положено, ключ С1:в, кэш сброшен во время записи, поколение 0, текущее 1");

КонецПроцедуры

&Тест
Процедура НехваткаМестаРядомСПишущимисяВиднаВЖурнале() Экспорт

	Лог.УстановитьУровень(УровниЛога.Отладка);
	Затвор = Новый Структура("Открыт, ЗаписьНачалась", Ложь, Ложь);
	Кэш = Новый Кэш("затвор", Новый ПоставщикСЗатвором(Затвор), Новый БюджетКэша(10, 10), 0);

	Параметры = Новый Массив;
	Параметры.Добавить(Кэш);
	Параметры.Добавить(Новый Структура("Вес, ЖдатьЗатвора", 7, Истина));
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВ", Параметры);
	Ожидаем.Что(Дождаться(Затвор)).ЭтоИстина();
	Кэш.Положить("г", Новый Структура("Вес, ЖдатьЗатвора", 4, Ложь));
	Затвор.Открыт = Истина;
	Ожидаем.Что(Задание.ОжидатьЗавершения(5000)).ЭтоИстина();

	ОжидатьСтроку("Кэш ""затвор"": не положено, ключ С1:г, вес 4 не помещается рядом с пишущимися, резерв 7, предел 10");

КонецПроцедуры

&Тест
Процедура ИстечениеИУдалённыеДанныеВидныВЖурнале() Экспорт

	Лог.УстановитьУровень(УровниЛога.Отладка);
	Срочный = Новый Кэш("срочный", Новый ПамятьКэша(), Новый БюджетКэша(10, 10), 0.05);
	Срочный.Положить("а", 1);
	Приостановить(200);
	Срочный.Получить("а");

	Файлы = Новый Кэш("файлы", Новый ФайлыКэша(Каталог), Новый БюджетКэша(1000, 100), 0);
	Файлы.Положить("документ", ПолучитьДвоичныеДанныеИзСтроки("текст"));
	УдалитьФайлы(Каталог, "*.cache");
	Файлы.Получить("документ");

	ОжидатьСтроку("Кэш ""срочный"": истекла, ключ С1:а, срок жизни 0.05 с");
	ОжидатьСтроку("Кэш ""файлы"": промах, ключ С8:документ, данные записи удалены во время чтения");

КонецПроцедуры

&Тест
Процедура НаУровнеИнформацияОтладочныхСтрокНет() Экспорт

	Лог.УстановитьУровень(УровниЛога.Информация);
	Кэш = Новый Кэш("след", Новый ПамятьКэша(), Новый БюджетКэша(1, 1), 0);

	Кэш.Получить("а");
	Кэш.Положить("а", 1);
	Кэш.Получить("а");
	Кэш.Положить("б", 2);
	Кэш.Удалить("б");

	Ожидаем.Что(Журнал.Сообщения.Количество()).Равно(0);

КонецПроцедуры

// Кладёт значение из фонового задания.
//
// Параметры:
//   Кэш      - Кэш - Кэш
//   Значение - Структура - Значение для поставщика с затвором
//
Процедура ПоложитьВ(Кэш, Значение) Экспорт
	Кэш.Положить("в", Значение);
КонецПроцедуры

Процедура ОжидатьСтроку(Строка)
	Ожидаем.Что(Журнал.Сообщения).Содержит(Строка);
КонецПроцедуры

Функция Дождаться(Затвор)

	Для Номер = 1 По 500 Цикл
		Если Затвор.ЗаписьНачалась Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Возврат Ложь;

КонецФункции
