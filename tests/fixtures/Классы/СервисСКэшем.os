// Фикстура: желудь с методами кэша; считает вызовы исходных методов.

Перем Вызовы;

&Кэшируемый("настройки")
Функция Настройка(&КлючКэша Пул, &КлючКэша Имя, Контекст) Экспорт
	Счесть("Настройка");
	Возврат СтрШаблон("%1/%2/%3", Пул, Имя, Контекст);
КонецФункции

&Кэшируемый("пустое")
Функция Пустое(Ключ) Экспорт
	Счесть("Пустое");
	Возврат Неопределено;
КонецФункции

&Кэшируемый("сбойное")
Функция Сбойное(Ключ) Экспорт
	Счесть("Сбойное");
	ВызватьИсключение "Сбой исходного метода";
КонецФункции

&Кэшируемый("объекты")
Функция ПоОбъекту(Объект) Экспорт
	Счесть("ПоОбъекту");
	Возврат 1;
КонецФункции

&Кэшируемый("малый")
Функция Малое(Номер) Экспорт
	Счесть("Малое");
	Возврат Номер;
КонецФункции

&Кэшируемый("безНастроек")
Функция БезНастроек(Номер) Экспорт
	Счесть("БезНастроек");
	Возврат Номер;
КонецФункции

&Кэшируемый("артефакты")
Функция Артефакт(Размер) Экспорт
	Счесть("Артефакт");
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(Размер));
КонецФункции

&Кэшируемый("артефакты")
Функция ТекстАртефакта(Ключ) Экспорт
	Счесть("ТекстАртефакта");
	Возврат "текст";
КонецФункции

&СбрасываетКэш("настройки")
Процедура ЗабытьНастройку(&КлючКэша Пул, &КлючКэша Имя, Причина) Экспорт
КонецПроцедуры

&СбрасываетКэш(Значение = "настройки", ВсеЗаписи = Истина)
Процедура ЗабытьВсеНастройки() Экспорт
КонецПроцедуры

&СбрасываетКэш("настройки")
Процедура НеудачноЗабыть(&КлючКэша Пул, &КлючКэша Имя) Экспорт
	ВызватьИсключение "Сбой при сбросе";
КонецПроцедуры

&СбрасываетКэш("малый")
&СбрасываетКэш("безНастроек")
Процедура ЗабытьНомер(Номер) Экспорт
КонецПроцедуры

Функция Вызовов(ИмяМетода) Экспорт
	Возврат ?(Вызовы[ИмяМетода] = Неопределено, 0, Вызовы[ИмяМетода]);
КонецФункции

Процедура Счесть(ИмяМетода)
	Вызовы.Вставить(ИмяМетода, Вызовов(ИмяМетода) + 1);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта()
	Вызовы = Новый Соответствие;
КонецПроцедуры
