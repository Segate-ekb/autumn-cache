// Фикстура: желудь с методами кэша; считает вызовы исходных методов и помнит отданные потоки.

Перем Вызовы;
Перем Отданные;
Перем Затвор;

&Кэшируемый("настройки")
Функция Настройка(&КлючКэша Раздел, &КлючКэша Имя, Контекст) Экспорт
	Счесть("Настройка");
	Возврат СтрШаблон("%1/%2/%3", Раздел, Имя, Контекст);
КонецФункции

&Кэшируемый("пустое")
Функция Пустое(Ключ) Экспорт
	Счесть("Пустое");
	Возврат Неопределено;
КонецФункции

&Кэшируемый("сбойное")
Функция Сбойное(Ключ) Экспорт
	Счесть("Сбойное");
	ВызватьИсключение "Сбой исходного метода";
КонецФункции

&Кэшируемый("объекты")
Функция ПоОбъекту(Объект) Экспорт
	Счесть("ПоОбъекту");
	Возврат 1;
КонецФункции

// Ждёт, пока тест не откроет затвор.
&Кэшируемый("медленное")
Функция Медленное(Ключ) Экспорт

	Счесть("Медленное");
	Затвор.МетодНачался = Истина;
	Для Номер = 1 По 500 Цикл
		Если Затвор.Открыт Тогда
			Прервать;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Возврат "результат";

КонецФункции

&СбрасываетКэш("медленное")
Процедура ЗабытьМедленное(Ключ) Экспорт
КонецПроцедуры

&Кэшируемый("малый")
Функция Малое(Номер) Экспорт
	Счесть("Малое");
	Возврат Номер;
КонецФункции

&Кэшируемый("безНастроек")
Функция БезНастроек(Номер) Экспорт
	Счесть("БезНастроек");
	Возврат Номер;
КонецФункции

&Кэшируемый("документы")
Функция Документ(Размер) Экспорт
	Счесть("Документ");
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(Размер));
КонецФункции

&Кэшируемый("документы")
Функция ТекстДокумента(Ключ) Экспорт
	Счесть("ТекстДокумента");
	Возврат "текст";
КонецФункции

&Кэшируемый("потоки")
Функция ПотокДокумента(Размер) Экспорт
	Счесть("ПотокДокумента");
	Возврат Отдать("ПотокДокумента", ТестовыеБайты.СУзором(Размер).ОткрытьПотокДляЧтения());
КонецФункции

&Кэшируемый("потокиВПамяти")
Функция ПотокОтчёта(Размер) Экспорт
	Счесть("ПотокОтчёта");
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ТестовыеБайты.СУзором(Размер));
	Возврат Отдать("ПотокОтчёта", Новый ПотокВПамяти(Буфер));
КонецФункции

&Кэшируемый("артефакты")
Функция Артефакт(&КлючКэша Sha256, Контекст) Экспорт
	Счесть("Артефакт");
	Возврат ТестовыеБайты.СУзором(10).ОткрытьПотокДляЧтения();
КонецФункции

&Кэшируемый("словари")
Функция Словарь(Код) Экспорт
	Счесть("Словарь");
	Результат = Новый Соответствие;
	Результат.Вставить("Код", Код);
	Возврат Результат;
КонецФункции

&Кэшируемый("профили")
Функция Профиль(Код) Экспорт
	Счесть("Профиль");
	Возврат Новый ФиксированнаяСтруктура("Код, Имя", Код, "имя " + Код);
КонецФункции

&Кэшируемый("изменяемые")
Функция ИзменяемыйПрофиль(Код) Экспорт
	Счесть("ИзменяемыйПрофиль");
	Возврат Новый Структура("Код", Код);
КонецФункции

&СбрасываетКэш("настройки")
Процедура ЗабытьНастройку(&КлючКэша Раздел, &КлючКэша Имя, Причина) Экспорт
КонецПроцедуры

&СбрасываетКэш(Значение = "настройки", ВсеЗаписи = Истина)
Процедура ЗабытьВсеНастройки() Экспорт
КонецПроцедуры

&СбрасываетКэш("настройки")
Процедура НеудачноЗабыть(&КлючКэша Раздел, &КлючКэша Имя) Экспорт
	ВызватьИсключение "Сбой при сбросе";
КонецПроцедуры

&СбрасываетКэш("малый")
&СбрасываетКэш("безНастроек")
Процедура ЗабытьНомер(Номер) Экспорт
КонецПроцедуры

Процедура УстановитьЗатвор(ЗатворМетода) Экспорт
	Затвор = ЗатворМетода;
КонецПроцедуры

Функция Вызовов(ИмяМетода) Экспорт
	Возврат ?(Вызовы[ИмяМетода] = Неопределено, 0, Вызовы[ИмяМетода]);
КонецФункции

// Поток, который исходный метод вернул последним.
Функция Отданный(ИмяМетода) Экспорт
	Возврат Отданные[ИмяМетода];
КонецФункции

Процедура Счесть(ИмяМетода)
	Вызовы.Вставить(ИмяМетода, Вызовов(ИмяМетода) + 1);
КонецПроцедуры

Функция Отдать(ИмяМетода, Поток)
	Отданные.Вставить(ИмяМетода, Поток);
	Возврат Поток;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
	Вызовы = Новый Соответствие;
	Отданные = Новый Соответствие;
КонецПроцедуры
