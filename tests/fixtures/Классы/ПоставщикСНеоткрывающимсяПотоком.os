// Фикстура: обёртка поставщика кэша, у которой поток над только что записанной записью не открывается.

Перем Поставщик;
Перем Сбой;

Функция ВесПотока(Размер, ТекстКлюча) Экспорт
	Возврат Поставщик.ВесПотока(Размер, ТекстКлюча);
КонецФункции

Функция ЗаписатьПоток(Поток) Экспорт
	Возврат Поставщик.ЗаписатьПоток(Поток);
КонецФункции

// Отдаёт Неопределено или, если так задан сбой, вызывает исключение.
Функция ОткрытьПоток(Данные) Экспорт

	Если Сбой = "исключение" Тогда
		ВызватьИсключение "Сбой открытия потока над записью";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура Удалить(Данные) Экспорт
	Поставщик.Удалить(Данные);
КонецПроцедуры

Процедура ПриСозданииОбъекта(ОбёрнутыйПоставщик, ВидСбоя)
	Поставщик = ОбёрнутыйПоставщик;
	Сбой = ВидСбоя;
КонецПроцедуры
