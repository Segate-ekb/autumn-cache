#Использовать decorator
#Использовать reflector

// Фикстура: соседний напильник внутри кэша; журналирует свои перехватчики на кэшируемых методах.
// Деталька «свидетель.Вложенный» строит его отдельным декоратором, без объединения слоёв.

Перем Журнал Экспорт;
Перем Вложенный;

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Построитель = Новый ПостроительДекоратора(Желудь)
		.ОбъединятьСлои(НЕ Вложенный)
		.Поле(Новый Поле("Декоратор_ЖурналВнутреннегоСвидетеля"));
	Для Каждого Метод Из ОпределениеЖелудя.НайтиМетодыСАннотациями("Кэшируемый") Цикл
		Построитель
			.Перехватчик(ЗаписьВЖурнал(Метод.Имя, ТипыПерехватчиковМетода.Перед))
			.Перехватчик(ЗаписьВЖурнал(Метод.Имя, ТипыПерехватчиковМетода.После))
			.Перехватчик(ЗаписьВЖурнал(Метод.Имя, ТипыПерехватчиковМетода.ПослеВызоваИсключения));
	КонецЦикла;

	Декоратор = Построитель.Построить();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Декоратор, "Декоратор_ЖурналВнутреннегоСвидетеля", Журнал);

	Возврат Декоратор;

КонецФункции

Функция ЗаписьВЖурнал(ИмяМетода, ТипПерехватчика)
	Возврат Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипПерехватчика)
		.Тело("Декоратор_ЖурналВнутреннегоСвидетеля.Добавить(""" + ТипПерехватчика + """);");
КонецФункции

&Напильник(ПрименяетсяТолькоНа = "СервисСКэшем")
&Порядок(300)
Процедура ПриСозданииОбъекта(&Деталька(Значение = "свидетель.Вложенный", ЗначениеПоУмолчанию = Ложь) ВложенныйДекоратор)
	Журнал = Новый Массив;
	Вложенный = ВложенныйДекоратор;
КонецПроцедуры
