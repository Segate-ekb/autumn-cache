// Фикстура: байты с узором, по которым видна подмена или сдвиг, и чтение потока до конца.

// Байты, которые отличаются от соседних и от байтов с другим зерном.
//
// Параметры:
//   Размер - Число - Сколько байт
//   Зерно  - Число - Сдвиг узора
//
// Возвращаемое значение:
//   ДвоичныеДанные - Байты
//
Функция СУзором(Размер, Зерно = 0) Экспорт

	Буфер = Новый БуферДвоичныхДанных(Размер);
	Для Индекс = 0 По Размер - 1 Цикл
		Буфер.Установить(Индекс, (Индекс * 7 + Зерно) % 256);
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

// Читает поток от текущей позиции до конца и закрывает его.
//
// Параметры:
//   Поток - Поток, ФайловыйПоток, ПотокВПамяти - Поток
//
// Возвращаемое значение:
//   ДвоичныеДанные - Прочитанные байты
//
Функция ИзПотока(Поток) Экспорт

	Копия = Новый ПотокВПамяти();
	Поток.КопироватьВ(Копия);
	Поток.Закрыть();

	Возврат Копия.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции
