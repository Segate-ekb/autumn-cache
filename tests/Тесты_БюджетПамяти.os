#Использовать ".."
#Использовать "../src/internal"
#Использовать "fixtures"
#Использовать asserts

// Кэши в памяти с общим бюджетом в байтах: оценка веса, отказ изменяемым значениям, общий SLRU.

Перем Память;

&ПередКаждым
Процедура СоздатьПамять() Экспорт
	Память = Новый ПамятьКэша(Истина);
КонецПроцедуры

&Тест
Процедура ЗаписьВеситНакладныеКлючИЗначение() Экспорт

	Ожидаем.Что(Память.Вес(Истина, "С1:к")).Равно(1750 + 56 + 8);
	Ожидаем.Что(Память.Вес(Истина, "С1:к")).Больше(0);

КонецПроцедуры

&Тест
Процедура ВесПримитивовПоФормулам() Экспорт

	Ожидаем.Что(ВесЗначения(Истина)).Равно(0);
	Ожидаем.Что(ВесЗначения(Неопределено)).Равно(0);
	Ожидаем.Что(ВесЗначения(42)).Равно(32);
	Ожидаем.Что(ВесЗначения(Дата(2026, 1, 1))).Равно(40);
	Ожидаем.Что(ВесЗначения(Новый УникальныйИдентификатор)).Равно(40);
	Ожидаем.Что(ВесЗначения("абв")).Равно(62);
	Ожидаем.Что(ВесЗначения(ПолучитьДвоичныеДанныеИзСтроки("0123456789"))).Равно(110);

КонецПроцедуры

&Тест
Процедура ВесФиксированныхКоллекцийСуммируетсяВглубь() Экспорт

	Элементы = Новый Массив;
	Элементы.Добавить(1);
	Элементы.Добавить("а");
	Вложенное = Новый Соответствие;
	Вложенное.Вставить("к", Новый ФиксированныйМассив(Новый Массив));

	Ожидаем.Что(ВесЗначения(Новый ФиксированнаяСтруктура("А", 1))).Равно(700 + 100 + 58 + 32);
	Ожидаем.Что(ВесЗначения(Новый ФиксированныйМассив(Элементы))).Равно(180 + 8 + 32 + 8 + 58);
	Ожидаем.Что(ВесЗначения(Новый ФиксированноеСоответствие(Вложенное))).Равно(200 + 52 + 58 + 180);

КонецПроцедуры

&Тест
Процедура КэшБулевыхДержитНеБольшеПределаНаНакладные() Экспорт

	// Булево ничего не весит, но запись под ним — нет: 1750 накладных и 68 на ключ «С3:кNN».
	ВесЗаписи = 1750 + 68;
	Кэш = Новый Кэш("права", Память, Новый БюджетКэша(10 * ВесЗаписи, ВесЗаписи), 0);

	Для Номер = 1 По 50 Цикл
		Кэш.Положить(КлючНомера(Номер), Истина);
	КонецЦикла;

	Ожидаем.Что(Кэш.Статистика().Занято).Равно(10 * ВесЗаписи);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(40);

КонецПроцедуры

&Тест
Процедура ИзменяемыеИНеоцениваемыеЗначенияОтвергаются() Экспорт

	Внутри = Новый Массив;
	Внутри.Добавить(Новый Массив);

	ПроверитьОтказ(Новый Структура, "изменяемое");
	ПроверитьОтказ(Новый Соответствие, "изменяемое");
	ПроверитьОтказ(Новый Массив, "изменяемое");
	ПроверитьОтказ(Новый ТаблицаЗначений, "изменяемое");
	ПроверитьОтказ(Новый ФиксированныйМассив(Внутри), "изменяемое");
	ПроверитьОтказ(Новый ЖурналВПамяти, "не оценивается");

КонецПроцедуры

&Тест
Процедура ДваКэшаДелятОбщийБюджет() Экспорт

	// Запись числа под ключом «С3:кNN» весит 1850, бюджет — ровно 31 запись. «а» кладёт 10 записей
	// и читает первые пять, «б» кладёт 30: вытесняются пять непрочитанных записей «а», потом
	// четыре старейшие записи «б».
	ВесЗаписи = 1750 + 68 + 32;
	Бюджет = Новый БюджетКэша(31 * ВесЗаписи, ВесЗаписи);
	А = Новый Кэш("а", Новый ПамятьКэша(Истина), Бюджет, 0);
	Б = Новый Кэш("б", Новый ПамятьКэша(Истина), Бюджет, 0);

	Для Номер = 1 По 10 Цикл
		А.Положить(КлючНомера(Номер), Номер);
	КонецЦикла;
	Для Номер = 1 По 5 Цикл
		А.Получить(КлючНомера(Номер));
	КонецЦикла;
	Для Номер = 1 По 30 Цикл
		Б.Положить(КлючНомера(Номер), Номер);
	КонецЦикла;

	Ожидаем.Что(А.Статистика().Вытеснения).Равно(5);
	Ожидаем.Что(Б.Статистика().Вытеснения).Равно(4);
	Ожидаем.Что(А.Статистика().Занято).Равно(5 * ВесЗаписи);
	Ожидаем.Что(Б.Статистика().Занято).Равно(26 * ВесЗаписи);
	Для Номер = 1 По 5 Цикл
		Ожидаем.Что(А.Получить(КлючНомера(Номер))).Равно(Номер);
	КонецЦикла;
	Ожидаем.Что(А.Получить(КлючНомера(6))).Равно(Неопределено);
	Ожидаем.Что(Б.Получить(КлючНомера(4))).Равно(Неопределено);
	Ожидаем.Что(Б.Получить(КлючНомера(5))).Равно(5);

КонецПроцедуры

&Тест
Процедура ОчиститьОдинКэшНеТрогаетДругой() Экспорт

	Бюджет = Новый БюджетКэша(100000, 10000);
	А = Новый Кэш("а", Новый ПамятьКэша(Истина), Бюджет, 0);
	Б = Новый Кэш("б", Новый ПамятьКэша(Истина), Бюджет, 0);
	А.Положить("к", 1);
	Б.Положить("к", 2);
	ЗанятоБ = Б.Статистика().Занято;

	А.Очистить();

	Ожидаем.Что(А.Получить("к")).Равно(Неопределено);
	Ожидаем.Что(А.Статистика().Занято).Равно(0);
	Ожидаем.Что(Б.Получить("к")).Равно(2);
	Ожидаем.Что(Бюджет.Занято()).Равно(ЗанятоБ);

КонецПроцедуры

&Тест
Процедура ПараллельныеОперацииДержатОбщийБюджет() Экспорт

	Бюджет = Новый БюджетКэша(40000, 4000);
	Кэши = Новый Массив;
	Кэши.Добавить(Новый Кэш("а", Новый ПамятьКэша(Истина), Бюджет, 0));
	Кэши.Добавить(Новый Кэш("б", Новый ПамятьКэша(Истина), Бюджет, 0));

	Задания = Новый Массив;
	Для НомерЗадания = 1 По 4 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Кэши[НомерЗадания % 2]);
		Параметры.Добавить(НомерЗадания);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "НагрузитьКэш", Параметры));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.ОжидатьЗавершения(10000)).ЭтоИстина();
		Ожидаем.Что(Задание.ИнформацияОбОшибке).Равно(Неопределено);
		Ожидаем.Что(Задание.Результат).Равно(0);
	КонецЦикла;
	Ожидаем.Что(Кэши[0].Статистика().Занято + Кэши[1].Статистика().Занято).Равно(Бюджет.Занято());
	Ожидаем.Что(Бюджет.Занято()).Не_().Больше(40000);

КонецПроцедуры

// Смешанные операции над кэшем; значение каждого ключа начинается с самого ключа.
//
// Параметры:
//   Кэш          - Кэш - Кэш общего бюджета
//   НомерЗадания - Число - Зерно генератора операций
//
// Возвращаемое значение:
//   Число - Сколько раз Получить отдал значение чужого ключа
//
Функция НагрузитьКэш(Кэш, НомерЗадания) Экспорт

	Нарушений = 0;
	Генератор = Новый ГенераторСлучайныхЧисел(НомерЗадания);

	Для Шаг = 1 По 2000 Цикл
		Ключ = "к" + Генератор.СлучайноеЧисло(0, 29);
		Операция = Генератор.СлучайноеЧисло(0, 99);
		Если Операция < 50 Тогда
			Кэш.Положить(Ключ, Ключ + "/" + НомерЗадания + "/" + Шаг);
		ИначеЕсли Операция < 85 Тогда
			Значение = Кэш.Получить(Ключ);
			Если Значение <> Неопределено И НЕ СтрНачинаетсяС(Значение, Ключ + "/") Тогда
				Нарушений = Нарушений + 1;
			КонецЕсли;
		ИначеЕсли Операция < 97 Тогда
			Кэш.Удалить(Ключ);
		Иначе
			Кэш.Очистить();
		КонецЕсли;
	КонецЦикла;

	Возврат Нарушений;

КонецФункции

Функция ВесЗначения(Значение)
	Возврат Память.Вес(Значение, "") - Память.Вес(Неопределено, "");
КонецФункции

Функция КлючНомера(Номер)
	Возврат "к" + Формат(Номер, "ЧЦ=2; ЧВН=");
КонецФункции

Процедура ПроверитьОтказ(Значение, ОжидаемыйТекст)

	Кэш = Новый Кэш("байты", Новый ПамятьКэша(Истина), Новый БюджетКэша(100000, 10000), 0);

	Попытка
		Кэш.Положить("ключ", Значение);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
		Возврат;
	КонецПопытки;

	ВызватьИсключение СтрШаблон("Ожидался отказ для значения типа %1", ТипЗнч(Значение));

КонецПроцедуры
