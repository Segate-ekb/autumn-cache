КонецПроцедуры

&Тест
Процедура ПишущаясяЗаписьЗанимаетМестоДоКонцаЗаписи() Экспорт

	Затвор = Новый Структура("Открыт, ЗаписьНачалась", Ложь, Ложь);
	Кэш = Новый Кэш("с затвором", Новый ПоставщикСЗатвором(Затвор), Новый БюджетКэша(10, 10), 0);
	Кэш.Положить("а", ЗначениеВесом(4));
	Кэш.Положить("б", ЗначениеВесом(4));

	// «в» вытесняет «а» и ждёт затвора; её вес уже учтён, поэтому «г» вытесняет «б»,
	// хотя без резерва «б» и «г» уложились бы в предел.
	Параметры = Новый Массив;
	Параметры.Добавить(Кэш);
	Параметры.Добавить(ЗначениеВесом(4, Истина));
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВ", Параметры);
	Ожидаем.Что(Дождаться(Затвор, "ЗаписьНачалась")).ЭтоИстина();

	Кэш.Положить("г", ЗначениеВесом(4));

	Ожидаем.Что(Кэш.Получить("б")).Равно(Неопределено);
	Затвор.Открыт = Истина;
	Ожидаем.Что(Задание.ОжидатьЗавершения(5000)).ЭтоИстина();
	Ожидаем.Что(Кэш.Получить("в")).Не_().Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("г")).Не_().Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(2);

КонецПроцедуры

&Тест
Процедура СбросВоВремяЗаписиНеПерекрываетсяЗаписанным() Экспорт

	Для Каждого Сброс Из СтрРазделить("Удалить,Очистить", ",") Цикл

		Затвор = Новый Структура("Открыт, ЗаписьНачалась", Ложь, Ложь);
		Кэш = Новый Кэш("с затвором", Новый ПоставщикСЗатвором(Затвор), Новый БюджетКэша(10, 10), 0);

		Параметры = Новый Массив;
		Параметры.Добавить(Кэш);
		Параметры.Добавить(ЗначениеВесом(4, Истина));
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВ", Параметры);
		Ожидаем.Что(Дождаться(Затвор, "ЗаписьНачалась")).ЭтоИстина();

		Если Сброс = "Удалить" Тогда
			Кэш.Удалить("в");
		Иначе
			Кэш.Очистить();
		КонецЕсли;
		Затвор.Открыт = Истина;
		Ожидаем.Что(Задание.ОжидатьЗавершения(5000)).ЭтоИстина();

		Ожидаем.Что(Кэш.Получить("в")).Равно(Неопределено);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПараллельныеОперацииСохраняютЗначенияКлючей() Экспорт

	Кэш = КэшВПамяти(20);
	Задания = Новый Массив;
	Для НомерЗадания = 1 По 4 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Кэш);
		Параметры.Добавить(НомерЗадания);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "НагрузитьКэш", Параметры));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.ОжидатьЗавершения(10000)).ЭтоИстина();
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		Ожидаем.Что(Задание.Результат).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Смешанные операции над кэшем; значение каждого ключа начинается с самого ключа.
//
// Параметры:
//   Кэш          - Кэш - Кэш в памяти
//   НомерЗадания - Число - Зерно генератора операций
//
// Возвращаемое значение:
//   Число - Сколько раз Получить отдал значение чужого ключа
//
Функция НагрузитьКэш(Кэш, НомерЗадания) Экспорт

	Нарушений = 0;
	Генератор = Новый ГенераторСлучайныхЧисел(НомерЗадания);

	Для Шаг = 1 По 2000 Цикл
		Ключ = "к" + Генератор.СлучайноеЧисло(0, 29);
		Операция = Генератор.СлучайноеЧисло(0, 99);
		Если Операция < 50 Тогда
			Кэш.Положить(Ключ, Ключ + "/" + НомерЗадания + "/" + Шаг);
		ИначеЕсли Операция < 85 Тогда
			Значение = Кэш.Получить(Ключ);
			Если Значение <> Неопределено И НЕ СтрНачинаетсяС(Значение, Ключ + "/") Тогда
				Нарушений = Нарушений + 1;
			КонецЕсли;
		ИначеЕсли Операция < 97 Тогда
			Кэш.Удалить(Ключ);
		Иначе
			Кэш.Очистить();
		КонецЕсли;
	КонецЦикла;

	Возврат Нарушений;

КонецФункции

// Кладёт значение из фонового задания.
//
// Параметры:
//   Кэш      - Кэш - Кэш
//   Значение - Структура - Значение для поставщика с затвором
//
Процедура ПоложитьВ(Кэш, Значение) Экспорт
	Кэш.Положить("в", Значение);
КонецПроцедуры

Функция КэшВПамяти(Предел)
	Возврат Новый Кэш("проба", Новый ПамятьКэша(), Новый БюджетКэша(Предел, Предел), 0);
КонецФункции

Функция ЗначениеВесом(Вес, ЖдатьЗатвора = Ложь)
	Возврат Новый Структура("Вес, ЖдатьЗатвора", Вес, ЖдатьЗатвора);
КонецФункции

Функция Дождаться(Затвор, Признак)

	Для Номер = 1 По 500 Цикл
		Если Затвор[Признак] Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Возврат Ложь;

КонецФункции
