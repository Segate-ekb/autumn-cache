#Использовать ".."
#Использовать "../src/internal"
#Использовать "fixtures"
#Использовать asserts

// Кэш в памяти: предел, вытеснение SLRU, срок жизни, счётчики, резерв под пишущиеся записи.

&Тест
Процедура ПределВЗаписяхВытесняетСтарейшую() Экспорт

	Кэш = КэшВПамяти(3);
	Для Номер = 1 По 4 Цикл
		Кэш.Положить(Номер, "значение" + Номер);
	КонецЦикла;

	Ожидаем.Что(Кэш.Получить(1)).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить(4)).Равно("значение4");
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(1);

КонецПроцедуры

&Тест
Процедура РазовыеКлючиНеВымываютПовторноЗапрошенные() Экспорт

	Кэш = КэшВПамяти(10);
	Для Номер = 1 По 5 Цикл
		Кэш.Положить("частый" + Номер, Номер);
		Кэш.Получить("частый" + Номер);
	КонецЦикла;

	Для Номер = 1 По 100 Цикл
		Кэш.Положить("разовый" + Номер, Номер);
	КонецЦикла;

	Для Номер = 1 По 5 Цикл
		Ожидаем.Что(Кэш.Получить("частый" + Номер)).Равно(Номер);
	КонецЦикла;
	Ожидаем.Что(Кэш.Получить("разовый1")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПереполнениеЗащищённогоВозвращаетХвостНаИспытаниеБезВытеснения() Экспорт

	// Защищённый сегмент — 8 записей из 10: обращение к девятой и десятой возвращает
	// на испытание первую и вторую, а следующая новая запись вытесняет первую.
	Кэш = КэшВПамяти(10);
	Для Номер = 1 По 10 Цикл
		Кэш.Положить(Номер, Номер);
	КонецЦикла;
	Для Номер = 1 По 10 Цикл
		Кэш.Получить(Номер);
	КонецЦикла;
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(0);

	Кэш.Положить(11, 11);

	Ожидаем.Что(Кэш.Получить(1)).Равно(Неопределено);
	Для Номер = 2 По 11 Цикл
		Ожидаем.Что(Кэш.Получить(Номер)).Равно(Номер);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеопределеноИNullНеКладутся() Экспорт

	Кэш = КэшВПамяти(10);
	Кэш.Положить("пусто", Неопределено);
	Кэш.Положить("null", NULL);

	Ожидаем.Что(Кэш.Получить("пусто")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("null")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Промахи).Равно(2);

КонецПроцедуры

&Тест
Процедура ЗаписьИстекаетПоСрокуЖизни() Экспорт

	Кэш = Новый Кэш("срочный", Новый ПамятьКэша(), 10, 10, 0.2);
	Кэш.Положить("ключ", "значение");
	Ожидаем.Что(Кэш.Получить("ключ")).Равно("значение");

	Приостановить(300);

	Ожидаем.Что(Кэш.Получить("ключ")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(1);

КонецПроцедуры

&Тест
Процедура СчётчикиПопаданийИПромахов() Экспорт

	Кэш = КэшВПамяти(10);
	Кэш.Получить("ключ");
	Кэш.Положить("ключ", "значение");
	Кэш.Получить("ключ");
	Кэш.Получить("ключ");

	Статистика = Кэш.Статистика();
	Ожидаем.Что(Статистика.Попадания).Равно(2);
	Ожидаем.Что(Статистика.Промахи).Равно(1);
	Ожидаем.Что(Статистика.Вытеснения).Равно(0);

КонецПроцедуры

&Тест
Процедура ПовторноеПоложитьЗаменяетЗначение() Экспорт

	Кэш = КэшВПамяти(10);
	Кэш.Положить("ключ", "старое");
	Кэш.Положить("ключ", "новое");

	Ожидаем.Что(Кэш.Получить("ключ")).Равно("новое");
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(0);

КонецПроцедуры

&Тест
Процедура УдалитьИОчиститьНеСчитаютсяВытеснением() Экспорт

	Кэш = КэшВПамяти(10);
	Кэш.Положить("а", 1);
	Кэш.Положить("б", 2);
	Кэш.Положить("в", 3);

	Кэш.Удалить("а");
	Ожидаем.Что(Кэш.Получить("а")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("б")).Равно(2);

	Кэш.Очистить();
	Ожидаем.Что(Кэш.Получить("б")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("в")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(0);

КонецПроцедуры

&Тест
Процедура ОдиночноеЗначениеРавноКлючуИзОднойЧасти() Экспорт

	Кэш = КэшВПамяти(10);
	Кэш.Положить(Новый КлючКэша().Добавить("пул"), "значение");
	Ожидаем.Что(Кэш.Получить("пул")).Равно("значение");

	Кэш.Положить(Новый КлючКэша().Добавить("пул").Добавить(2), "составное");
	Ожидаем.Что(Кэш.Получить(Новый КлючКэша().Добавить("пул").Добавить(2.0))).Равно("составное");

КонецПроцедуры

&Тест
Процедура ПишущаясяЗаписьЗанимаетМестоДоКонцаЗаписи() Экспорт

	Затвор = Новый Структура("Открыт, ЗаписьНачалась", Ложь, Ложь);
	Кэш = Новый Кэш("с затвором", Новый ПоставщикСЗатвором(Затвор), 10, 10, 0);
	Кэш.Положить("а", ЗначениеВесом(4));
	Кэш.Положить("б", ЗначениеВесом(4));

	// «в» вытесняет «а» и ждёт затвора; её вес уже учтён, поэтому «г» вытесняет «б»,
	// хотя без резерва «б» и «г» уложились бы в предел.
	Параметры = Новый Массив;
	Параметры.Добавить(Кэш);
	Параметры.Добавить(ЗначениеВесом(4, Истина));
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВ", Параметры);
	Ожидаем.Что(Дождаться(Затвор, "ЗаписьНачалась")).ЭтоИстина();

	Кэш.Положить("г", ЗначениеВесом(4));

	Ожидаем.Что(Кэш.Получить("б")).Равно(Неопределено);
	Затвор.Открыт = Истина;
	Ожидаем.Что(Задание.ОжидатьЗавершения(5000)).ЭтоИстина();
	Ожидаем.Что(Кэш.Получить("в")).Не_().Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("г")).Не_().Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(2);

КонецПроцедуры

// Кладёт значение из фонового задания.
//
// Параметры:
//   Кэш      - Кэш - Кэш
//   Значение - Структура - Значение для поставщика с затвором
//
Процедура ПоложитьВ(Кэш, Значение) Экспорт
	Кэш.Положить("в", Значение);
КонецПроцедуры

Функция КэшВПамяти(Предел)
	Возврат Новый Кэш("проба", Новый ПамятьКэша(), Предел, Предел, 0);
КонецФункции

Функция ЗначениеВесом(Вес, ЖдатьЗатвора = Ложь)
	Возврат Новый Структура("Вес, ЖдатьЗатвора", Вес, ЖдатьЗатвора);
КонецФункции

Функция Дождаться(Затвор, Признак)

	Для Номер = 1 По 500 Цикл
		Если Затвор[Признак] Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Возврат Ложь;

КонецФункции
