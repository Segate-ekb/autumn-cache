&Тест
Процедура УдалитьИОчиститьНеСчитаютсяВытеснением() Экспорт

	Кэш = КэшВПамяти(10);
	Кэш.Положить("а", 1);
	Кэш.Положить("б", 2);
	Кэш.Положить("в", 3);

	Кэш.Удалить("а");
	Ожидаем.Что(Кэш.Получить("а")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("б")).Равно(2);

	Кэш.Очистить();
	Ожидаем.Что(Кэш.Получить("б")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("в")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Вытеснения).Равно(0);

