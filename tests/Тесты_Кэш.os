&Тест
Процедура ПотокХранитсяДвоичнымиДаннымиИОтдаётсяПотокомНадНими() Экспорт

	Исходные = ТестовыеБайты.СУзором(100);
	Данные = Новый ПамятьКэша().ЗаписатьПоток(Исходные.ОткрытьПотокДляЧтения());
	Ожидаем.Что(ТипЗнч(Данные)).Равно(Тип("ДвоичныеДанные"));
	Ожидаем.Что(Данные).Равно(Исходные);

	Кэш = КэшВПамяти(10);
	Источник = Исходные.ОткрытьПотокДляЧтения();

	Выдача = Кэш.Положить("поток", Источник);

	Ожидаем.Что(Источник.ДоступноЧтение).ЭтоЛожь();
	Ожидаем.Что(ТестовыеБайты.ИзПотока(Выдача)).Равно(Исходные);
	Для Номер = 1 По 2 Цикл
		Попадание = Кэш.Получить("поток");
		Ожидаем.Что(ТипЗнч(Попадание)).Равно(Тип("Поток"));
		Ожидаем.Что(Попадание.ДоступнаЗапись).ЭтоЛожь();
		Ожидаем.Что(ТестовыеБайты.ИзПотока(Попадание)).Равно(Исходные);
	КонецЦикла;
	Ожидаем.Что(Кэш.Статистика().Занято).Равно(1);

КонецПроцедуры

