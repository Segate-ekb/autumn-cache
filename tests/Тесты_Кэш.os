&Тест
Процедура НеоткрывшийсяПотокНадДаннымиОтменяетЗапись() Экспорт

	Для Каждого Сбой Из СтрРазделить("Неопределено,исключение", ",") Цикл

		Бюджет = Новый БюджетКэша(10, 10);
		Кэш = Новый Кэш("проба", Новый ПоставщикСНеоткрывающимсяПотоком(Новый ПамятьКэша(), Сбой), Бюджет, 0);
		Исходные = ТестовыеБайты.СУзором(100);
		Источник = Исходные.ОткрытьПотокДляЧтения();
		Источник.Перейти(30, ПозицияВПотоке.Начало);

		Выдача = Кэш.Запомнить(Новый КлючКэша().Добавить("поток"), Источник, Кэш.Поколение());

		Ожидаем.Что(Выдача = Источник).ЭтоИстина();
		Ожидаем.Что(Источник.ТекущаяПозиция()).Равно(30);
		Ожидаем.Что(Бюджет.Занято()).Равно(0);
		Ожидаем.Что(Кэш.Получить("поток")).Равно(Неопределено);

	КонецЦикла;

КонецПроцедуры

