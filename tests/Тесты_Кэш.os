	Кэш.Положить("null", NULL);

	Ожидаем.Что(Кэш.Получить("пусто")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Получить("null")).Равно(Неопределено);
	Ожидаем.Что(Кэш.Статистика().Промахи).Равно(2);

КонецПроцедуры

