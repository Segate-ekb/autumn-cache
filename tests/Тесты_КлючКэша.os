#Использовать ".."
#Использовать asserts

// Ключ кэша: допустимые типы, однозначность текста, одно число — один ключ.

&Тест
Процедура ПримитивыДопустимыВКлюче() Экспорт

	Ключ = Новый КлючКэша()
		.Добавить("строка")
		.Добавить(42)
		.Добавить(Дата(2026, 9, 25, 12, 0, 0))
		.Добавить(Истина)
		.Добавить(Новый УникальныйИдентификатор("11111111-2222-3333-4444-555555555555"))
		.Добавить(Неопределено);

	Ожидаем.Что(Ключ.Текст()).Равно(
		"С6:строкаЧ2:42Д19:2026-09-25T12:00:00Б4:trueУ36:11111111-2222-3333-4444-555555555555Н0:");

КонецПроцедуры

&Тест
Процедура ОбъектВКлючеВызываетИсключениеСТипом() Экспорт

	Ключ = Новый КлючКэша().Добавить("пул");

	Попытка
		Ключ.Добавить(Новый Структура);
	Исключение
		Ожидаем.Что(ОписаниеОшибки())
			.Содержит(Строка(Тип("Структура")))
			.Содержит("не может быть частью ключа кэша (часть №2)");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение для значения-объекта";

КонецПроцедуры

&Тест
Процедура ТипИГраницыЧастейРазличаются() Экспорт

	Ожидаем.Что(ТекстКлюча("1")).Не_().Равно(ТекстКлюча(1));
	Ожидаем.Что(ТекстКлюча(Истина)).Не_().Равно(ТекстКлюча("true"));
	Ожидаем.Что(ТекстКлюча("ab", "c")).Не_().Равно(ТекстКлюча("a", "bc"));

КонецПроцедуры

&Тест
Процедура РавныеЧислаДаютОдинКлюч() Экспорт

	Ожидаем.Что(ТекстКлюча(1.0)).Равно(ТекстКлюча(1));
	Ожидаем.Что(ТекстКлюча(2 / 2)).Равно(ТекстКлюча(1));
	Ожидаем.Что(ТекстКлюча(1.50)).Равно(ТекстКлюча(1.5));
	Ожидаем.Что(ТекстКлюча(100)).Равно("Ч3:100");

КонецПроцедуры

Функция ТекстКлюча(Первое, Второе = "")

	Ключ = Новый КлючКэша().Добавить(Первое);
	Если Второе <> "" Тогда
		Ключ.Добавить(Второе);
	КонецЕсли;

	Возврат Ключ.Текст();

КонецФункции
