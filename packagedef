////////////////////////////////////////////////////////////
// Описание пакета autumn-cache для сборки и установки
//

Описание.Имя("autumn-cache")
		.Версия("0.2.3")
		.Автор("Egor Ivanov")
		.АдресРепозитория("https://github.com/Segate-ekb/autumn-cache")
		.Описание("Кэширование результатов методов желудей ОСени аннотациями &Кэшируемый и &СбрасываетКэш: поставщики в памяти и в файлах, общий бюджет памяти в байтах, настройки каждого кэша по имени, вытеснение SLRU, срок жизни записей")
		.ВерсияСреды("2.0.0")

		.ЗависитОт("autumn", "4.3.15")
		.ЗависитОт("decorator", "3.1.0")
		.ЗависитОт("annotations", "1.6.0")
		.ЗависитОт("reflector", "0.7.1")
		.ЗависитОт("logos", "1.7.1")

		.РазработкаЗависитОт("asserts", "1.6.0")
		.РазработкаЗависитОт("oneunit", "0.5.2")

		.ОпределяетКласс("МенеджерКэшей", "src/Классы/МенеджерКэшей.os")
		.ОпределяетКласс("Кэш", "src/Классы/Кэш.os")
		.ОпределяетКласс("КлючКэша", "src/Классы/КлючКэша.os")

		.ВключитьФайл("packagedef")
		.ВключитьФайл("src")
		.ВключитьФайл("README.md")
		.ВключитьФайл("LICENSE");
